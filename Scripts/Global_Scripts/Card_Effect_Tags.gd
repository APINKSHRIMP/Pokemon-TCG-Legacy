extends RefCounted

# ══════════════════════════════════════════════════════════════════════════════
# CARD EFFECT TAGS — the data behind the card search's EFFECTS filter.
# ══════════════════════════════════════════════════════════════════════════════
# Reads res://Card_Set_Data/Effect_Tags/Card_Effect_Tags.json, which is GENERATED by
# Scripts/Utilities/card_effect_tags_build.py from every set's card text. Never hand-edit the
# JSON: change the rules in that script and re-run it (it must report "0 untagged").
#
# No class_name on purpose (new class_names trip the editor's class cache). Use it as
#   const EffectTags = preload("res://Scripts/Global_Scripts/Card_Effect_Tags.gd")
#   EffectTags.categories()  /  EffectTags.matches(card_id, keys, mode, scope)
#
# JSON shape:
#   categories: [ {key, label, group, desc}, ... ]   (screen order)
#   cards:      { card_id: { key: source_bits } }
# source_bits is WHERE on the card the effect lives:
#   SRC_ATTACK 1 = an attack · SRC_POWER 2 = Power / Poke-Power / Poke-Body · SRC_CARD 4 = Trainer or
#   Special Energy text. The search's "FOUND ON" toggles AND this against a mask.
# ══════════════════════════════════════════════════════════════════════════════

const TAGS_PATH := "res://Card_Set_Data/Effect_Tags/Card_Effect_Tags.json"
const ICON_DIR  := "res://Image_Assets/Icons/Effect_Icons/"

const SRC_ATTACK := 1
const SRC_POWER  := 2
const SRC_CARD   := 4
const SRC_ALL    := 7

## Display names for the picker's section headers, keyed by the JSON "group".
const GROUP_TITLES := {
	"DAMAGE":  "ATTACK DAMAGE",
	"DEFENCE": "DEFENCE & HEALING",
	"STATUS":  "SPECIAL CONDITIONS",
	"ENERGY":  "ENERGY",
	"CARDS":   "CARDS & DECK",
	"BOARD":   "BENCH & EVOLUTION",
	"RULES":   "RULES & LOCKS",
	"SYNERGY": "SYNERGY",
	"VERSUS":  "VS OPPONENT",
}

static var _loaded := false
static var _categories : Array = []
static var _by_key : Dictionary = {}
static var _cards : Dictionary = {}


static func _ensure() -> void:
	if _loaded:
		return
	_loaded = true
	var f := FileAccess.open(TAGS_PATH, FileAccess.READ)
	if f == null:
		push_error("CardEffectTags: cannot open " + TAGS_PATH + " - run card_effect_tags_build.py")
		return
	var data = JSON.parse_string(f.get_as_text())
	f.close()
	if not (data is Dictionary):
		push_error("CardEffectTags: " + TAGS_PATH + " is not a JSON object")
		return
	_categories = data.get("categories", [])
	_cards = data.get("cards", {})
	for c in _categories:
		_by_key[String(c["key"])] = c


## Every category, in screen order: [{key, label, group, desc}, ...]
static func categories() -> Array:
	_ensure()
	return _categories


static func category(key: String) -> Dictionary:
	_ensure()
	return _by_key.get(key, {})


static func icon_path(key: String) -> String:
	return ICON_DIR + "effect_" + key + ".png"


static var _icon_cache : Dictionary = {}

## The badge pre-scaled to `px` square. Use this, not load(icon_path()), on a Button: a Button sizes
## itself off the texture's REAL height (64px), so the raw art makes every chip ~55px tall however
## icon_max_width is set. Cached per key + size.
static func icon(key: String, px: int) -> Texture2D:
	var ck := "%s@%d" % [key, px]
	if _icon_cache.has(ck):
		return _icon_cache[ck]
	var tex = load(icon_path(key))
	if not (tex is Texture2D):
		return null
	var img : Image = (tex as Texture2D).get_image()
	if img == null:
		return tex
	img = img.duplicate()
	if img.is_compressed():
		img.decompress()
	img.resize(px, px, Image.INTERPOLATE_LANCZOS)
	var out := ImageTexture.create_from_image(img)
	_icon_cache[ck] = out
	return out


## {category_key: source_bits} for one card; empty when the card has no effect text.
static func tags_for(card_id: String) -> Dictionary:
	_ensure()
	return _cards.get(card_id, {})


## Does the card carry the wanted effects, anywhere inside `scope` (a SRC_* mask)?
##   mode "any" - at least one of the keys (the OR-within-a-category rule every other row uses)
##   mode "all" - every one of the keys (the picker's MATCH ALL toggle)
## An empty key list is no filter at all.
static func matches(card_id: String, keys: Array, mode: String = "any", scope: int = SRC_ALL) -> bool:
	if keys.is_empty():
		return true
	var tags := tags_for(card_id)
	if tags.is_empty():
		return false
	var want_all := mode == "all"
	for k in keys:
		var hit := (int(tags.get(String(k), 0)) & scope) != 0
		if hit and not want_all:
			return true
		if not hit and want_all:
			return false
	return want_all


## How many cards in the given sets carry `key` (any source). Used to hide categories the player
## cannot possibly find yet, the same way the screen hides gated options.
static func count_in_sets(key: String, set_ids: Array) -> int:
	_ensure()
	var allowed := {}
	for s in set_ids:
		allowed[String(s)] = true
	var n := 0
	for cid in _cards:
		var sid := String(cid).split("-")[0]
		if allowed.has(sid) and (_cards[cid] as Dictionary).has(key):
			n += 1
	return n


## Every category key that has at least one card in the given sets (one pass over the data).
static func keys_present_in_sets(set_ids: Array) -> Dictionary:
	_ensure()
	var allowed := {}
	for s in set_ids:
		allowed[String(s)] = true
	var out := {}
	for cid in _cards:
		if allowed.has(String(cid).split("-")[0]):
			for k in (_cards[cid] as Dictionary):
				out[k] = true
	return out


## {category_key: card count} over the given sets, for every key present (one pass over the data).
static func counts_in_sets(set_ids: Array) -> Dictionary:
	_ensure()
	var allowed := {}
	for s in set_ids:
		allowed[String(s)] = true
	var out := {}
	for cid in _cards:
		if allowed.has(String(cid).split("-")[0]):
			for k in (_cards[cid] as Dictionary):
				out[k] = int(out.get(k, 0)) + 1
	return out
