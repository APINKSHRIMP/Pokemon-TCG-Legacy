	_attack_dispatch["derail"]          = func(atk, a, d, opp): var b=parse_attack_base_damage(atk); await execute_ex10_derail(a, d, opp, b); await _attack_finish(true, b, atk, a.metadata.get("types",["Colorless"]), opp)
