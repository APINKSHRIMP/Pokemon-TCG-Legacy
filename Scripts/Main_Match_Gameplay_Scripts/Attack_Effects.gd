func _register_neo2_attacks() -> void:
	# ----- ATTACKS WITH UNIQUE LOGIC -----
	_attack_dispatch["lock-on"]         = func(atk, a, d, opp): await execute_neo2_lock_on(a, opp);                                              await _attack_finish(false, 0,  atk, a.metadata.get("types",["Colorless"]), opp)
