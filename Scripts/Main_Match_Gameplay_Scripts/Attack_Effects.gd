	main.display_pokemon(is_opponent)
	main.update_discard_pile_display(is_opponent)
	await main.show_message("ATTACHED " + chosen.metadata.get("name","").to_upper() + " FROM THE DISCARD PILE!")
	if main._should_bail(): return

