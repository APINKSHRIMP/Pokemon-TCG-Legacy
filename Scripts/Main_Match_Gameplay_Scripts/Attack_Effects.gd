	# ── ex Pokemon attacks ──
	_attack_dispatch["hyper whirlpool"]    = func(atk, a, d, opp): var b=parse_attack_base_damage(atk); await execute_ex6_hyper_whirlpool(a, d, opp, b); await _attack_finish(true, b, atk, a.metadata.get("types",["Colorless"]), opp)
