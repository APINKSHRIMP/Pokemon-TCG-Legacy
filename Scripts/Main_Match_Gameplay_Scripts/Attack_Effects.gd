func _neo4_bench_basics_from_hand(side_is_opponent: bool) -> void:
	await _neo4_provoke_side(side_is_opponent, side_is_opponent)

# Provoke half: `chooser_is_opp` looks at `victim_is_opp`'s hand and benches any number of its Baby/Basic
# Pokémon onto the victim's Bench. The CPU benches the player's easy Knock Outs (60 HP or less).
func _neo4_provoke_side(victim_is_opp: bool, chooser_is_opp: bool) -> void:
	var hand = main.opponent_hand if victim_is_opp else main.player_hand
	var bench = main.opponent_bench if victim_is_opp else main.player_bench
	# MULTI-SELECT: the player picks every Pokemon to bench on one screen
	var player_picks: Array = []
	if not chooser_is_opp:
		if victim_is_opp:
			await _reveal_opp_hand(false, "PROVOKE")   # ISSUE #367: "Look at your opponent's hand"
			if main._should_bail(): return
		var pool: Array = hand.filter(func(c): return c.metadata.get("supertype","") == "Pokémon" and ("Basic" in c.metadata.get("subtypes",[]) or "Baby" in c.metadata.get("subtypes",[])))
		if pool.is_empty() or bench.size() >= main.get_max_bench_size():
			return
		var who_s = "YOUR" if not victim_is_opp else "OPPONENT'S"
		player_picks = await main.card_ops.prompt_select_cards(pool, 0, main.get_max_bench_size() - bench.size(),
			"PROVOKE — " + who_s + " HAND", "Choose any number of Basic Pokémon to put onto " + who_s.to_lower() + " Bench", "BENCH")
		if main._should_bail(): return
	while bench.size() < main.get_max_bench_size():
		var basics: Array = hand.filter(func(c): return c.metadata.get("supertype","") == "Pokémon" and ("Basic" in c.metadata.get("subtypes",[]) or "Baby" in c.metadata.get("subtypes",[])))
		if basics.is_empty():
			break
		var pick: card_object = null
		if chooser_is_opp:
			if victim_is_opp:
				break   # the CPU never forces its own hand onto its Bench
			for c in basics:
				if int(c.metadata.get("hp", "999")) <= 60 and (pick == null or int(c.metadata.get("hp","0")) < int(pick.metadata.get("hp","0"))):
					pick = c
			if pick == null:
				break
		else:
			if player_picks.is_empty():
				break
			pick = player_picks.pop_front()
		hand.erase(pick)
		pick.current_hp = int(pick.metadata.get("hp","10"))
		main.card_ops.place_on_bench(pick, victim_is_opp)
	main.display_pokemon(victim_is_opp)
	main.refresh_hand_display(victim_is_opp)

# BATTLE FRENZY (neo4-21 Dark Ursaring): flip for each Pokemon in play; heads = 20 to it (no W/R)
func execute_neo4_battle_frenzy(attacker: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var all_poke: Array = []
	if main.player_active_pokemon != null: all_poke.append({"p": main.player_active_pokemon, "opp": false})
	for bp in main.player_bench: all_poke.append({"p": bp, "opp": false})
	if main.opponent_active_pokemon != null: all_poke.append({"p": main.opponent_active_pokemon, "opp": true})
	for bp in main.opponent_bench: all_poke.append({"p": bp, "opp": true})
	var hits = 0
	for entry in all_poke:
		var coin = await main.flip_coin(all_poke.size() > 1, is_opponent)
		if main._should_bail(): return
		if coin and entry["p"].current_hp > 0:
			await main.card_ops.apply_bench_damage(entry["p"], 20, entry["opp"])
			hits += 1
	main.display_pokemon(false)
	main.display_pokemon(true)
	await main.show_message("BATTLE FRENZY! " + str(hits) + " POKEMON HIT FOR 20!")
	if main._should_bail(): return
	await main.check_all_knockouts()
	if main._should_bail(): return
	print("ATTACK EXECUTED: Battle Frenzy")

