# GATHER ENERGY (Elekid): search your deck for a basic Energy card and attach it to 1 of your Pokemon.
func execute_ex2_gather_energy(attacker: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var deck = main.opponent_deck if is_opponent else main.player_deck
	var basics = deck.filter(func(c): return _ex2_is_basic_energy(c))
	var targets = main.card_ops.get_all_pokemon_in_play(is_opponent)
	if basics.is_empty() or targets.is_empty():
		await main.show_message("GATHER ENERGY! NO BASIC ENERGY IN DECK!")
		if main._should_bail(): return
		deck.shuffle()
		return
	var ge_energy_rank = func(c): return main.cpu_ai.cpu_rank_keep_value(c)
	var chosen = await main.card_ops.choose_card(basics, is_opponent, "GATHER ENERGY", "Choose a basic Energy card from your deck", "SELECT", false, ge_energy_rank, true)
	if main._should_bail(): return
	if chosen != null:
		var ge_target_rank = func(c): return main.cpu_ai.cpu_rank_benefit_recipient(c, "energy", chosen)
		var target = targets[0] if targets.size() == 1 else await main.card_ops.choose_card(targets, is_opponent, "GATHER ENERGY", "Choose a Pokemon to attach it to", "ATTACH", false, ge_target_rank)
		if main._should_bail(): return
		if target != null:
			deck.erase(chosen)
			chosen.current_location = "attached"
			target.attached_energies.append(chosen)
			main.display_active_pokemon_energies(is_opponent)
			main.display_pokemon(is_opponent)
			await main.show_message("GATHER ENERGY! ATTACHED " + chosen.metadata.get("name","").to_upper() + "!")
			if main._should_bail(): return
	deck.shuffle()
	main.update_deck_icon(is_opponent)

# Shared: put up to `max_count` matching Basic Pokemon (filter_fn) from the deck onto your Bench.
# max_count < 0 means "as many as you like" (up to the Bench limit).
func _ex2_search_basics_to_bench(is_opponent: bool, filter_fn: Callable, max_count: int, header: String, any_stage: bool = false) -> void:
	var deck = main.opponent_deck if is_opponent else main.player_deck
	var bench = main.opponent_bench if is_opponent else main.player_bench
	var placed = 0
	# MULTI-SELECT: "up to N" / "as many as you like" — every pick on one screen, may be 0
	var player_picks: Array = []
	if not is_opponent:
		var room: int = main.get_max_bench_size() - bench.size()
		var cap: int = room if max_count < 0 else mini(room, max_count)
		var valid0 = deck.filter(func(c): return c.metadata.get("supertype","") == "Pokémon" and (any_stage or main.is_basic_pokemon(c)) and filter_fn.call(c))
		player_picks = await main.card_ops.prompt_select_cards(valid0, 0, cap, header,
			("Choose any number of Pokemon for your Bench" if max_count < 0 else "Choose up to " + str(cap) + " Pokemon for your Bench"), "BENCH")
		if main._should_bail(): return
	while bench.size() < main.get_max_bench_size():
		if max_count >= 0 and placed >= max_count:
			break
		# ISSUE #324: any_stage — Influence / Team Assembly name Stage 1 fossil Pokémon ("treat the new Benched
		# Pokémon as Basic"); the Basic-only filter meant Influence could never find anything.
		var valid = deck.filter(func(c): return c.metadata.get("supertype","") == "Pokémon" and (any_stage or main.is_basic_pokemon(c)) and filter_fn.call(c))
		if valid.is_empty():
			break
		var chosen: card_object = null
		if is_opponent:
			# ISSUE #324: rank by keep value (evolution lines it holds first), not raw HP; leave a Bench slot free
			# for "as many as you like" so it doesn't flood the Bench with prize fodder.
			if max_count < 0 and placed >= 3 and bench.size() >= main.get_max_bench_size() - 1:
				break
			var best_s = -INF
			for c in valid:
				var s = main.cpu_ai.cpu_rank_keep_value(c) + float(int(c.metadata.get("hp", "0"))) * 0.1
				if s > best_s:
					best_s = s
					chosen = c
		else:
			# ISSUE #324: "up to N" / "as many as you like" — the player may stop at any time, including at 0.
			chosen = player_picks.pop_front() if not player_picks.is_empty() else null
		if chosen == null:
			break
		deck.erase(chosen)
		chosen.current_hp = chosen.get_max_hp()
		main.card_ops.place_on_bench(chosen, is_opponent)
		placed += 1
	deck.shuffle()
	main.update_deck_icon(is_opponent)
	await main.show_message("PLACED " + str(placed) + " POKEMON ONTO THE BENCH!" if placed > 0 else "NO POKEMON PLACED!")
	if main._should_bail(): return

