# LAVA FLOW (ex3 Magcargo ex): discard any number of basic Energy from Magcargo ex; 40 + 20 each.
# Simplified: discard all basic Energy for maximum damage (same simplification as neo3 Lava Flow).
func execute_ex3_lava_flow(attacker: card_object, defender: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var basics: Array = []
	for e in attacker.attached_energies:
		if _ex2_is_basic_energy(e):
			basics.append(e)
	# ISSUE #327: "any number" — the player picks how many (all used to be discarded). The CPU discards the
	# fewest that Knock Out, else only its spare Energy.
	var lf_cpu := 0
	if is_opponent:
		lf_cpu = -1
		for k in range(basics.size() + 1):
			if r4_would_ko(attacker, defender, 40 + 20 * k):
				lf_cpu = k
				break
		if lf_cpu < 0:
			lf_cpu = 0
			for e in main.cpu_ai.cpu_own_energy_discard_order(attacker, attacker.attached_energies.size()):
				if e in basics and main.cpu_ai.cpu_own_energy_value(attacker, e) < 1000.0: lf_cpu += 1
	if is_opponent:
		var lf_n = await r3_choose_count(is_opponent, "LAVA FLOW: DISCARD HOW MANY BASIC ENERGY?", basics.size(), lf_cpu)
		if main._should_bail(): return
		var lf_order: Array = main.cpu_ai.cpu_own_energy_discard_order(attacker, attacker.attached_energies.size()).filter(func(e): return e in basics)
		basics = lf_order.slice(0, lf_n)
	elif not basics.is_empty():
		# MULTI-SELECT: "any number" picked on one screen (replaces the "how many?" prompt)
		basics = await main.card_ops.prompt_select_cards(basics, 0, basics.size(), "LAVA FLOW", "Choose any number of basic Energy to discard (+20 damage each)", "DISCARD")
		if main._should_bail(): return
	for e in basics:
		main.card_ops.discard_energy_from_pokemon(e, is_opponent)
		attacker.attached_energies.erase(e)
	if not basics.is_empty():
		main.display_active_pokemon_energies(is_opponent)
		main.update_discard_pile_display(is_opponent)
	var dmg = 40 + basics.size() * 20
	await main.show_message("LAVA FLOW! DISCARDED " + str(basics.size()) + " BASIC ENERGY — " + str(dmg) + " DAMAGE!")
	if main._should_bail(): return
	await gym1_hit_active(attacker, defender, is_opponent, dmg)
	if main._should_bail(): return
	await main.check_all_knockouts()
	if main._should_bail(): return

# GENETIC MEMORY (Kingdra ex): use any attack from Kingdra ex's Basic / Stage 1 cards (no cost).
# Self-finishing (execute_copied_attack calls _attack_finish) — mirrors execute_metronome.
func execute_ex3_genetic_memory(attacker: card_object, defender: card_object, is_opponent: bool, source_attack: Dictionary) -> void:
	if await handle_attack_confusion(attacker, is_opponent):
		await _attack_finish(false, 0, source_attack, attacker.metadata.get("types",["Colorless"]), is_opponent)
		return
	if await handle_attack_blind(attacker, is_opponent):
		await _attack_finish(false, 0, source_attack, attacker.metadata.get("types",["Colorless"]), is_opponent)
		return
	var pool: Array = []
	for pre in attacker.attached_pre_evolutions:
		for a in main.get_attacks_for_card(pre):
			if a.get("name","").to_lower() != "genetic memory":
				pool.append(a)
	if pool.is_empty():
		await main.show_message("GENETIC MEMORY! NO PRE-EVOLUTION ATTACKS AVAILABLE!")
		if main._should_bail(): return
		await _attack_finish(false, 0, source_attack, attacker.metadata.get("types",["Colorless"]), is_opponent)
		return
	var cpu_types = attacker.metadata.get("types", ["Colorless"])
	var cpu_rank = func(atk: Dictionary) -> float:
		var dmg_range = estimate_attack_damage_range(atk, attacker, defender)
		var result = main.calculate_final_damage(dmg_range["max"], cpu_types, defender)
		return float(result["damage"])
	var chosen = await choose_attack_from_pool(pool, is_opponent, cpu_rank)
	if chosen.is_empty():
		await _attack_finish(false, 0, source_attack, attacker.metadata.get("types",["Colorless"]), is_opponent)
		return
	await main.show_message(attacker.metadata.get("name","").to_upper() + " USES " + chosen.get("name","").to_upper() + "!")
	if main._should_bail(): return
	await execute_copied_attack(chosen, attacker, defender, is_opponent, false)
	if main._should_bail(): return

######################################################################################################################################################
############################################## EX4 (TEAM MAGMA VS TEAM AQUA) ATTACK EFFECTS ##########################################################
######################################################################################################################################################
# Single-battle behaviour today, written against the double-battle helpers
# (card_ops.get_active_pokemon / get_defending_pokemon / get_all_pokemon_in_play) so a future
# Double Battle mode only changes those. The set's signature mechanic is the "Team Aqua"/"Team
# Magma in its name" check, derived from card_object.metadata.name (see _ex4_name_has).

# True if the card's name contains `team` ("Team Aqua" / "Team Magma").
func _ex4_name_has(c: card_object, team: String) -> bool:
	if c == null: return false
	return team in c.metadata.get("name", "")

# Count Pokemon in play for a side (Active + Bench) whose name contains `team`.
func _ex4_count_named_in_play(is_opponent: bool, team: String) -> int:
	var n := 0
	for p in main.card_ops.get_all_pokemon_in_play(is_opponent):
		if _ex4_name_has(p, team): n += 1
	return n

# The opponent's targetable Pokemon (Active + Bench) relative to the attacker.
func _ex4_opp_pool(is_opponent: bool) -> Array:
	return _ex3_opp_snipe_pool(is_opponent, false)

# The "N more damage" bonus written on the card (default 20).
func _ex4_more(atk: Dictionary) -> int:
	var b = extract_number_before(atk.get("text","").to_lower(), "more damage")
	return b if b > 0 else 20

func _register_ex4_attacks() -> void:
	# ── Collision overrides (registered last → win for every set; branch on ex4 wording) ──
	# Crush: ex4 Aggron = flip per Energy, 30×heads; others (Exeggutor Big Eggsplosion) = 20×.
	_attack_dispatch["crush"] = func(atk, a, d, opp):
		var text = atk.get("text","").to_lower()
		if "times the number of heads" in text:
			var per = parse_attack_base_damage(atk)
			await execute_big_eggsplosion(a, d, opp, per if per > 0 else 20)
		else:
			await execute_big_eggsplosion(a, d, opp)
		await _attack_finish(true, 0, atk, a.metadata.get("types",["Colorless"]), opp)
	# Overrun: ex4 = pure Bench snipe 10 (no Active hit); ecard1/base = Active + Bench-snipe-flip.
	_attack_dispatch["overrun"] = func(atk, a, d, opp):
		var text = atk.get("text","").to_lower()
		if "benched pokémon. this attack does 10 damage to that pokémon" in text:
			await execute_ex3_choose_snipe(a, opp, 10, true)
			await _attack_finish(false, 0, atk, a.metadata.get("types",["Colorless"]), opp)
		else:
