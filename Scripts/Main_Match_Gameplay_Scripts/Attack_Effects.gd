		await main.show_message("HEADS! " + defender.metadata.get("name","").to_upper() + " CAN'T ATTACK OR RETREAT NEXT TURN!")
		if main._should_bail(): return
	elif not coin:
		await main.show_message("TAILS! SCARY FACE HAD NO EFFECT!")
		if main._should_bail(): return
