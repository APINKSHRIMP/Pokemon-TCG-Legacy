	var total = 50 + heads * 10
	if counters > 0:
		await main.show_message("CHOMP! " + str(heads) + "/" + str(counters) + " HEADS — " + str(total) + " DAMAGE!")
		if main._should_bail(): return
	await gym1_hit_active(attacker, defender, is_opponent, total)
	if main._should_bail(): return
