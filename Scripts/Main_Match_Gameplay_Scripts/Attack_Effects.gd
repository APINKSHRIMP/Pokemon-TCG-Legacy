		if main._should_bail(): return
		if target == null:
			target = opp_active
	var heads = 0
	for i in range(3):
		var coin = await main.flip_coin(true, is_opponent)
		if coin:
			heads += 1
	var dmg = 10 * heads
	await main.show_message("GOT " + str(heads) + " HEADS! " + str(dmg) + " DAMAGE!")
