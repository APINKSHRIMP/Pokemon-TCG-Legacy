	for c in hand:
		if gym1_is_basic_energy(c) and "Grass" in main.get_energy_provided_by_card(c):
			grass.append(c)
	if grass.size() == 0:
		await main.show_message("HEADS! NO GRASS ENERGY IN HAND!")
