# FIRE SPIN (Camerupt): discard 2 basic Energy attached to self, or this attack does nothing.
func execute_ex1_fire_spin(attacker: card_object, defender: card_object, is_opponent: bool, basic_only: bool = true, base: int = 100) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	# ISSUE #295/#297: base1-4 Charizard discards ANY 2 Energy cards (ex1 = 2 basic Energy). The player
	# now chooses which (was always the first two attached); the CPU gives up its least valuable.
	var pool = attacker.attached_energies.filter(func(e): return gym1_is_basic_energy(e)) if basic_only else attacker.attached_energies.duplicate()
	if pool.size() < 2:
		await main.show_message("NOT ENOUGH ENERGY — FIRE SPIN DID NOTHING!")
		if main._should_bail(): return
		return
	# MULTI-SELECT: the player picks both Energy on one screen (only when it is a real choice)
	var player_picks: Array = []
	if not is_opponent:
		if pool.size() > 2:
			player_picks = await main.card_ops.prompt_select_cards(pool, 2, 2, "FIRE SPIN", "Choose 2 " + ("basic " if basic_only else "") + "Energy cards to discard", "DISCARD")
			if main._should_bail(): return
		else:
			player_picks = pool.slice(0, 2)
	for i in range(2):
		var forced: card_object = null
		if not is_opponent:
			if i < player_picks.size():
				forced = player_picks[i]
		else:
			# CPU: rank inside the legal pool
			var legal = attacker.attached_energies.filter(func(e): return gym1_is_basic_energy(e)) if basic_only else attacker.attached_energies.duplicate()
			var order = main.cpu_ai.cpu_own_energy_discard_order(attacker, attacker.attached_energies.size())
			for e in order:
				if e in legal:
					forced = e
					break
			if forced == null:
				forced = legal[0]
		await main.card_ops.remove_one_energy(attacker, is_opponent, is_opponent, forced)
		if main._should_bail(): return
	await gym1_hit_active(attacker, defender, is_opponent, base)
	if main._should_bail(): return
	await main.check_all_knockouts()
	if main._should_bail(): return
	print("ATTACK EXECUTED: Fire Spin")

# MAX ENERGY SOURCE (Delcatty): 10 damage times the total Energy attached across all of your
# Active Pokemon (1 Active in single battles — sums to just this Pokemon's attached Energy).
func execute_ex1_max_energy_source(attacker: card_object, defender: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var total_energy = 0
	for p in main.card_ops.get_active_pokemon(is_opponent):
		total_energy += p.attached_energies.size()
	var dmg = 10 * total_energy
	await main.show_message(str(total_energy) + " ENERGY ATTACHED — " + str(dmg) + " DAMAGE!")
	if main._should_bail(): return
	if dmg > 0:
		await gym1_hit_active(attacker, defender, is_opponent, dmg)
		if main._should_bail(): return
	await main.check_all_knockouts()
	if main._should_bail(): return
	print("ATTACK EXECUTED: Max Energy Source — ", dmg, " damage")

# ENERGY BURST (Gardevoir): 10 damage times the total Energy attached to Gardevoir + the Defending Pokemon.
func execute_ex1_energy_burst(attacker: card_object, defender: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var total_energy = attacker.attached_energies.size() + defender.attached_energies.size()
	var dmg = 10 * total_energy
	await main.show_message(str(total_energy) + " TOTAL ENERGY — " + str(dmg) + " DAMAGE!")
	if main._should_bail(): return
	if dmg > 0:
		await gym1_hit_active(attacker, defender, is_opponent, dmg)
		if main._should_bail(): return
	await main.check_all_knockouts()
	if main._should_bail(): return
	print("ATTACK EXECUTED: Energy Burst — ", dmg, " damage")

