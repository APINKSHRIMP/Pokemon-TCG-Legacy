	if main._should_bail(): return
	if not coin:
		await main.show_message("TAILS! SWEET NECTAR FAILED!")
		if main._should_bail(): return
		return
	var own_poke: Array = []
	var active = main.opponent_active_pokemon if is_opponent else main.player_active_pokemon
