# HEALING STEPS (ex8-10 Ludicolo): base damage, then discard as many hand cards as you like to remove
# that many damage counters from Ludicolo.
func execute_ex8_healing_steps(attacker: card_object, defender: card_object, is_opponent: bool, base_damage: int) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	await gym1_hit_active(attacker, defender, is_opponent, base_damage)
	if main._should_bail(): return
	var hand = main.opponent_hand if is_opponent else main.player_hand
	var needed = attacker.get_damage_counters()
	var discarded = 0
	if is_opponent:
		# ISSUE #332: the CPU discarded its FIRST cards (its best ones included). It now discards only cards it
		# values below 35, worst first, up to the damage counters it has.
		var hs_pool = hand.duplicate()
		hs_pool.sort_custom(func(x, y): return main.cpu_ai.cpu_rank_keep_value(x) < main.cpu_ai.cpu_rank_keep_value(y))
		for c in hs_pool:
			if discarded >= needed or main.cpu_ai.cpu_rank_keep_value(c) >= 35.0: break
			await main.card_ops.send_to_discard(c, is_opponent, false)
			if main._should_bail(): return
			discarded += 1
	else:
		var hs_picks: Array = await main.card_ops.prompt_select_cards(hand.duplicate(), 0, hand.size(), "HEALING STEPS",
			"Choose any number of cards to discard (heal 1 damage counter each)", "DISCARD")
		if main._should_bail(): return
		for pick in hs_picks:
			await main.card_ops.send_to_discard(pick, false, false)
			if main._should_bail(): return
			discarded += 1
	if discarded > 0:
		await main.card_ops.heal_pokemon(attacker, discarded * 10, is_opponent)
		if main._should_bail(): return
	await main.check_all_knockouts()

