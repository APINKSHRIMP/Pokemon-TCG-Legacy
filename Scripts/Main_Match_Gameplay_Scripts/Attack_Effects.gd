# POWER CRUSH (Latias ex δ ex15-95): 90 damage; if the Defending Pokémon is Knocked Out, discard 2 Fire
# Energy attached to Latias ex.
func execute_ex15_power_crush(attacker: card_object, defender: card_object, is_opponent: bool, base_damage: int) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	await gym1_hit_active(attacker, defender, is_opponent, base_damage)
	if main._should_bail(): return
	var ko = defender != null and defender.current_hp <= 0
	await main.check_all_knockouts()
	if main._should_bail(): return
	if ko:
		var discarded = 0
		var pc_fire = attacker.attached_energies.filter(func(e): return "Fire" in main.get_energy_provided_by_card(e))
		for i in range(min(2, pc_fire.size())):
			# ISSUE #339: the owner picks which Fire Energy go (Holon / multi-type cards matter).
			var pc_e = pc_fire[0] if pc_fire.size() <= (2 - i) else await r4_pick_own_energy(attacker, pc_fire, is_opponent, "POWER CRUSH: DISCARD A FIRE ENERGY (" + str(i + 1) + " OF 2)")
			if main._should_bail(): return
			pc_fire.erase(pc_e)
			main.card_ops.discard_energy_from_pokemon(pc_e, is_opponent, false)
			discarded += 1
		if discarded > 0:
			main.display_active_pokemon_energies(is_opponent)
			main.display_pokemon(is_opponent)
			await main.show_message("POWER CRUSH! DISCARDED " + str(discarded) + " FIRE ENERGY FROM " + attacker.metadata.get("name","").to_upper() + "!")
			if main._should_bail(): return

# DUAL STREAM (Salamence ex δ ex15-98): 80 damage, or you may do 40 to the Defending Pokémon instead and 40
# to 1 of your opponent's Benched Pokémon.
func execute_ex15_dual_stream(attacker: card_object, defender: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var opp_bench = main.player_bench if is_opponent else main.opponent_bench
	var split = false
	if is_opponent:
		# ISSUE #339: the CPU always split. Keep 80 when only 80 Knocks Out the Defender; split when 40 is enough,
		# or when 40 Knocks Out a Benched Pokemon and 80 wouldn't KO the Defender anyway.
		var ds_live = opp_bench.filter(func(p): return p.current_hp > 0)
		if not ds_live.is_empty():
			var ko80 = r4_would_ko(attacker, defender, 80)
			var ko40 = r4_would_ko(attacker, defender, 40)
			var bench_ko = ds_live.any(func(p): return p.current_hp <= 40)
			split = ko40 or (bench_ko and not ko80)
	elif not opp_bench.filter(func(p): return p.current_hp > 0).is_empty():
		split = await main.trainer_effects.gym1_prompt_yes_no(attacker, "DUAL STREAM", "Do 40 to the Defending Pokémon and 40 to a Benched Pokémon (instead of 80)?", "SPLIT", "80 TO ACTIVE")
		if main._should_bail(): return
	if split:
		await gym1_hit_active(attacker, defender, is_opponent, 40)
		if main._should_bail(): return
		await main.check_all_knockouts()
		if main._should_bail(): return
		await execute_ex3_choose_snipe(attacker, is_opponent, 40, true)
		if main._should_bail(): return
	else:
		await gym1_hit_active(attacker, defender, is_opponent, 80)
		if main._should_bail(): return
		await main.check_all_knockouts()
		if main._should_bail(): return

# ELECTROMARK (Tyranitar ex δ ex15-99): put a Shock-wave marker on 1 of your opponent's Pokémon.
func execute_ex15_electromark(attacker: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var pool = main.card_ops.get_all_pokemon_in_play(not is_opponent)
	if pool.is_empty():
		await main.show_message("NO OPPONENT POKÉMON!")
		if main._should_bail(): return
		return
	var target: card_object = null
	if is_opponent:
		# ISSUE #339: mark the biggest threat that isn't marked yet (Pokemon-ex = 2 Prizes); the Active breaks ties.
		var em_best := -INF
		for c in pool:
			var s: float = main.cpu_ai._cpu_threat_score(c) + (50.0 if main.is_ex_pokemon(c) else 0.0) + (5.0 if c == main.player_active_pokemon else 0.0) - (1000.0 if c.shockwave_markers > 0 else 0.0)
			if s > em_best:
				em_best = s
				target = c
		if target == null: target = pool[0]
	else:
		target = await main.card_ops.choose_card(pool, false, "ELECTROMARK", "Put a Shock-wave marker on which opponent's Pokémon?", "SELECT", false)
		if main._should_bail(): return
		if target == null: target = pool[0]
	target.shockwave_markers += 1
	main.display_pokemon(not is_opponent)
	await main.show_message("ELECTROMARK! A SHOCK-WAVE MARKER IS ON " + target.metadata.get("name","").to_upper() + "!")
	if main._should_bail(): return

# SHOCK-WAVE (Tyranitar ex δ ex15-99): choose 1 of your opponent's Pokémon that has any Shock-wave markers
# on it; that Pokémon is Knocked Out.
func execute_ex15_shockwave_ko(attacker: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var pool = main.card_ops.get_all_pokemon_in_play(not is_opponent).filter(func(p): return p.shockwave_markers > 0)
	if pool.is_empty():
		await main.show_message("SHOCK-WAVE: NO OPPONENT POKÉMON HAS A SHOCK-WAVE MARKER!")
		if main._should_bail(): return
		return
	var target: card_object = null
	if is_opponent:
		# ISSUE #339: KO the most valuable marked Pokemon (was "the Active if marked").
		target = main.cpu_ai.cpu_pick_snipe_target(pool, 9999)
		if target == null: target = pool[0]
	else:
		target = pool[0] if pool.size() == 1 else await main.card_ops.choose_card(pool, false, "SHOCK-WAVE", "Knock Out which marked Pokémon?", "KO", false)
		if main._should_bail(): return
		if target == null: target = pool[0]
	target.current_hp = 0
	main.display_hp_circles_above_align(target, not is_opponent)
	await main.show_message("SHOCK-WAVE! " + target.metadata.get("name","").to_upper() + " IS KNOCKED OUT!")
	if main._should_bail(): return
	await main.check_all_knockouts()
	if main._should_bail(): return

# DARK SWIRL (Charizard Star δ ex15-100): 150 damage; discard all Energy attached to Charizard Star and
# discard the top 3 cards of your opponent's deck.
func execute_ex15_dark_swirl(attacker: card_object, defender: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	await gym1_hit_active(attacker, defender, is_opponent, 150)
	if main._should_bail(): return
	await main.check_all_knockouts()
	if main._should_bail(): return
	for e in attacker.attached_energies.duplicate():
		main.card_ops.discard_energy_from_pokemon(e, is_opponent, false)
	main.display_active_pokemon_energies(is_opponent)
	main.display_pokemon(is_opponent)
	# Discard the top 3 cards of the opponent's deck.
	var opp_deck = main.player_deck if is_opponent else main.opponent_deck
	var opp_discard = main.player_discard_pile if is_opponent else main.opponent_discard_pile
	var milled = 0
	for i in range(3):
		if opp_deck.is_empty(): break
		var c: card_object = opp_deck.pop_front()   # ISSUE #340: was pop_back (the BOTTOM card)
		c.current_location = "discard"
		opp_discard.append(c)
		milled += 1
	main.update_deck_icon(not is_opponent)
	main.update_discard_pile_display(not is_opponent)
	await main.show_message("DARK SWIRL! DISCARDED ALL ENERGY AND MILLED " + str(milled) + " OF YOUR OPPONENT'S CARDS!")
	if main._should_bail(): return

######################################################################################################################################################
############################################## EX16 (EX POWER KEEPERS) ATTACK EFFECTS ###############################################################
######################################################################################################################################################
# Final ex-series set. Reprint-heavy: the vast majority of attacks resolve via the GENERIC parser
# (status / coin bonus / times-heads / self-damage / energy discard / bench spread / retreat lock /
# toxic / smokescreen / heal / extra-energy-with-cap) or via existing dispatch handlers that read
# their numbers from the card. Registered LAST so ex16 collision overrides win. Written single-battle
# today but through card_ops.get_active/defending/all_pokemon_in_play so a future Double Battle mode
# only changes those helpers.
func _register_ex16_attacks() -> void:
	# -- Collision overrides (branch on ex16 uid; else delegate to the prior handler) --
	var _pv_mixup16 = _attack_dispatch.get("mix-up")
	_attack_dispatch["mix-up"] = func(atk, a, d, opp):
		if a.uid.begins_with("ex16-"):   # ex16 Aggron = 70 + opponent always discards top of deck (no coin)
			var b = parse_attack_base_damage(atk)
			await execute_ex16_mix_up(a, d, opp, b)
			await _attack_finish(true, b, atk, a.metadata.get("types",["Colorless"]), opp)
		elif _pv_mixup16: await _pv_mixup16.call(atk, a, d, opp)

	var _pv_darkmind16 = _attack_dispatch.get("dark mind")
	# ISSUE #295: every Dark Mind printing (base3-5/3-8 Gengar & Hypno, ex2, ex16) does its printed damage to
	# the Defending Pokémon AND N to 1 chosen Benched Pokémon. The ex2 fallback used to skip the base damage.
	_attack_dispatch["dark mind"] = func(atk, a, d, opp):
		var dm_text = atk.get("text","").to_lower()
		var b = parse_attack_base_damage(atk)
		var n = extract_number_before(dm_text, "damage to 1 of your opponent")
		if n <= 0: n = extract_number_before(dm_text, "damage to it")
		if n <= 0: n = 10
		await execute_dark_mind(a, d, opp, b, n)
		await _attack_finish(true, b, atk, a.metadata.get("types",["Colorless"]), opp)

	var _pv_wreck16 = _attack_dispatch.get("wreck")
	_attack_dispatch["wreck"] = func(atk, a, d, opp):
		if a.uid.begins_with("ex16-"):   # ex16 Walrein ex = 70 (+20 if any Stadium in play, then discard it)
			var dmg = await execute_ex16_wreck(a, d, opp)
			await _attack_finish(true, dmg, atk, a.metadata.get("types",["Colorless"]), opp)
		elif _pv_wreck16: await _pv_wreck16.call(atk, a, d, opp)

	# -- Novel ex16 attacks --
	_attack_dispatch["dark burst"]       = func(atk, a, d, opp): var dmg=await execute_ex16_dark_burst(a, d, opp); await _attack_finish(true, dmg, atk, a.metadata.get("types",["Colorless"]), opp)
	_attack_dispatch["dirge"]            = func(atk, a, d, opp): var b=parse_attack_base_damage(atk); await execute_ex16_same_name_blast(a, d, opp, b); await _attack_finish(true, b, atk, a.metadata.get("types",["Colorless"]), opp)
	_attack_dispatch["scanblast"]        = func(atk, a, d, opp): var b=parse_attack_base_damage(atk); await execute_ex16_same_name_blast(a, d, opp, b); await _attack_finish(true, b, atk, a.metadata.get("types",["Colorless"]), opp)
	_attack_dispatch["grudge"]           = func(atk, a, d, opp): var dmg=await execute_ex16_grudge(a, d, opp); await _attack_finish(true, dmg, atk, a.metadata.get("types",["Colorless"]), opp)
	_attack_dispatch["hydro wave"]       = func(atk, a, d, opp): await execute_ex16_hydro_wave(a, d, opp); await _attack_finish(false, 0, atk, a.metadata.get("types",["Colorless"]), opp)
	# "Mysterious Light" also exists on a gym1 card (coin → Asleep, no damage); only ex16 Dusclops uses the
	# Phoebe's Stadium confuse variant. Non-ex16 cards fall through to the GENERIC effect resolver.
	_attack_dispatch["mysterious light"] = func(atk, a, d, opp):
		if a.uid.begins_with("ex16-"):
			var b=parse_attack_base_damage(atk); await execute_ex16_mysterious_light(a, d, opp, b); await _attack_finish(true, b, atk, a.metadata.get("types",["Colorless"]), opp)
		else:
			await execute_generic_copied_attack(atk, a, d, opp, true)
	_attack_dispatch["rock blast"]       = func(atk, a, d, opp): await execute_ex16_rock_blast(a, d, opp); await _attack_finish(false, 0, atk, a.metadata.get("types",["Colorless"]), opp)
	_attack_dispatch["volcanic flame"]   = func(atk, a, d, opp): var b=parse_attack_base_damage(atk); await execute_ex16_volcanic_flame(a, d, opp, b); await _attack_finish(true, b, atk, a.metadata.get("types",["Colorless"]), opp)
	_attack_dispatch["skill hack"]       = func(atk, a, d, opp): await execute_ex16_skill_hack(a, d, opp, atk)
	# Mach Claw (Armaldo ex16-3): base damage that isn't affected by Resistance (Weakness still applies).
	_attack_dispatch["mach claw"]        = func(atk, a, d, opp): var b=parse_attack_base_damage(atk); await execute_ex16_mach_claw(a, d, opp, b); await _attack_finish(true, b, atk, a.metadata.get("types",["Colorless"]), opp)

