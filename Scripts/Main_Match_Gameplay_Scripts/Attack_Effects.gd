			if chosen == null: break
		await main.card_ops.recover_to_hand(chosen, is_opponent)
		if main._should_bail(): return
		moved += 1
	await main.show_message("RECOVERED " + str(moved) + " BASIC ENERGY TO HAND!")
	if main._should_bail(): return

