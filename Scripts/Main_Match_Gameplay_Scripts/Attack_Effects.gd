# PICKUP (ex6 Raticate): search discard for a Basic Pokemon (or Evolution card), a Trainer card, and an
# Energy card; put them into your hand.
func execute_ex6_pickup(attacker: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var discard = main.opponent_discard_pile if is_opponent else main.player_discard_pile
	var categories = [
		{"label": "a Pokemon", "fn": func(c): return c.metadata.get("supertype","") == "Pokémon"},
		{"label": "a Trainer", "fn": func(c): return c.metadata.get("supertype","") == "Trainer"},
		{"label": "an Energy", "fn": func(c): return c.metadata.get("supertype","") == "Energy"},
	]
	if not is_opponent:
		# MULTI-SELECT: up to 1 of each kind (Pokemon / Trainer / Energy) on one screen
		var pu_pool: Array = discard.filter(func(c): return c.metadata.get("supertype","") in ["Pokémon", "Trainer", "Energy"])
		var pu_picks: Array = await main.card_ops.prompt_select_cards(pu_pool, 0, 3, "PICKUP",
			"Choose up to 1 Pokemon, 1 Trainer and 1 Energy from your discard pile", "TAKE", false, false,
			main.card_ops.distinct_key_validator(func(c): return c.metadata.get("supertype","")))
		if main._should_bail(): return
		for pick in pu_picks:
			await main.card_ops.recover_to_hand(pick, is_opponent)
			if main._should_bail(): return
		categories = []
	for cat in categories:
		var pool = discard.filter(cat["fn"])
		if pool.is_empty():
			continue
		var pick: card_object = main.cpu_ai.cpu_pick_best_keep(pool)   # ISSUE #330
		if pick == null: pick = pool[0]
		await main.card_ops.recover_to_hand(pick, is_opponent)
		if main._should_bail(): return
	await main.show_message("PICKUP! RECOVERED CARDS FROM THE DISCARD PILE!")
	if main._should_bail(): return

# LOOK FOR FRIENDS (ex6 Nidoran ♀): reveal cards from the top of your deck until you reveal a Basic
# Pokemon; put it into your hand, shuffle the rest back.
func execute_ex6_look_for_friends(attacker: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var deck = main.opponent_deck if is_opponent else main.player_deck
	var hand = main.opponent_hand if is_opponent else main.player_hand
	# ISSUE #367: "Reveal cards from your deck until you reveal a Basic Pokémon" — the revealed cards were never shown.
	var revealed: Array = []
	var found: card_object = null
	for c in deck:
		revealed.append(c)
		if c.metadata.get("supertype","") == "Pokémon" and "Basic" in c.metadata.get("subtypes", []):
			found = c
			break
	if not revealed.is_empty():
		await main.card_ops.show_cards(revealed, "LOOK FOR FRIENDS — REVEALED", ("Your opponent revealed " if is_opponent else "You revealed ") + str(revealed.size()) + " card(s)")
		if main._should_bail(): return
	if found != null:
		deck.erase(found)
		found.current_location = "hand"
		hand.append(found)
		main.refresh_hand_display(is_opponent)
		await main.show_message("LOOK FOR FRIENDS! ADDED " + found.metadata.get("name","").to_upper() + " TO " + ("THEIR" if is_opponent else "YOUR") + " HAND!")
	else:
		await main.show_message("LOOK FOR FRIENDS! NO BASIC POKEMON FOUND!")
	deck.shuffle()
	main.update_deck_icon(is_opponent)
	if main._should_bail(): return

# HYPER WHIRLPOOL (Blastoise ex): base damage, then flip a coin until tails; for each heads, the
# opponent discards an Energy card attached to the Defending Pokemon.
func execute_ex6_hyper_whirlpool(attacker: card_object, defender: card_object, is_opponent: bool, base_damage: int, attacker_picks: bool = false) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	await gym1_hit_active(attacker, defender, is_opponent, base_damage)
	if main._should_bail(): return
	await main.check_all_knockouts()
	if main._should_bail(): return
	if defender == null or defender.current_hp <= 0:
		return
	var heads = 0
	while true:
		var coin = await main.flip_coin(true, is_opponent)
		if main._should_bail(): return
		if coin:
			heads += 1
		else:
			break
	for i in range(heads):
		if defender.attached_energies.is_empty(): break
		# ISSUE #325: ex7-12 Kingdra — the ATTACKER chooses ("discard an Energy"); ex6 — "your opponent discards".
		await main.card_ops.remove_one_energy(defender, not is_opponent, is_opponent if attacker_picks else not is_opponent)
		if main._should_bail(): return
	await main.show_message("HYPER WHIRLPOOL! " + str(heads) + " HEADS — DISCARDED ENERGY!")
	if main._should_bail(): return

# BURN DOWN (Charizard ex): discard 5 Fire Energy from Charizard ex, then deal `base` damage unaffected
# by Weakness, Resistance, Poke-Powers, Poke-Bodies, or any other effect on the Defending Pokemon.
func execute_ex6_burn_down(attacker: card_object, defender: card_object, is_opponent: bool, base_damage: int) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var fire = attacker.attached_energies.filter(func(e): return "Fire" in main.get_energy_provided_by_card(e))
	var to_discard = min(5, fire.size())
	for i in range(to_discard):
		var bd_e = fire[0] if fire.size() <= (5 - i) else await r4_pick_own_energy(attacker, fire, is_opponent, "BURN DOWN: DISCARD A FIRE ENERGY (" + str(i + 1) + " OF 5)")
		if main._should_bail(): return
		fire.erase(bd_e)
		main.card_ops.discard_energy_from_pokemon(bd_e, is_opponent)
	main.display_active_pokemon_energies(is_opponent)
	main.update_discard_pile_display(is_opponent)
	# ISSUE #330: "isn't affected by Weakness, Resistance, Poké-Powers, Poké-Bodies, and any other effects on the
	# Defending Pokémon" is Swift's rule (Sonicboom still let Defender/Harden etc. reduce it).
	await execute_swift(attacker, defender, is_opponent, base_damage)
	if main._should_bail(): return

# CRUSH AND BURN (Electrode ex): you may discard as many Energy as you like attached to your Pokemon in
# play. Deal base + `per` damage for each Energy discarded.
func execute_ex6_crush_and_burn(attacker: card_object, defender: card_object, is_opponent: bool, base_damage: int, per: int) -> int:
	if await handle_attack_confusion(attacker, is_opponent): return 0
	if await handle_attack_blind(attacker, is_opponent): return 0
	var discarded = 0
	if is_opponent:
		# ISSUE #330: was "CPU keeps its Energy" (a stub). The CPU discards the fewest Energy that Knock Out —
		# taken from the Pokémon that need them least — and otherwise keeps them.
		var cb_all: Array = []
		for p in main.card_ops.get_all_pokemon_in_play(true):
			for e in p.attached_energies:
				cb_all.append({"p": p, "e": e, "v": main.cpu_ai.cpu_own_energy_value(p, e) + (500.0 if p == attacker else 0.0)})
		cb_all.sort_custom(func(x, y): return x["v"] < y["v"])
		var cb_need := 0
		for k in range(1, cb_all.size() + 1):
			if r4_would_ko(attacker, defender, base_damage + per * k):
				cb_need = k
				break
		for it in cb_all.slice(0, cb_need):
			main.card_ops.discard_energy_from_pokemon(it["e"], true)
			discarded += 1
		if discarded > 0:
			main.display_active_pokemon_energies(true)
			main.display_pokemon(true)
			main.update_discard_pile_display(true)
	else:
		# MULTI-SELECT: every Energy attached to your Pokémon, any number, on one screen (ISSUE #330: you pick the cards)
		var cb_pool: Array = []
		for p in main.card_ops.get_all_pokemon_in_play(false):
			cb_pool.append_array(p.attached_energies)
		var cb_picks: Array = await main.card_ops.prompt_select_cards(cb_pool, 0, cb_pool.size(), "CRUSH AND BURN",
			"Choose any number of Energy attached to your Pokémon to discard (+" + str(per) + " damage each)", "DISCARD")
		if main._should_bail(): return 0
		for e in cb_picks:
			main.card_ops.discard_energy_from_pokemon(e, false)
			discarded += 1
		main.display_active_pokemon_energies(false)
		main.display_pokemon(false)
		main.update_discard_pile_display(false)
	var dmg = base_damage + per * discarded
	await main.show_message("CRUSH AND BURN! DISCARDED " + str(discarded) + " — " + str(dmg) + " DAMAGE!")
	if main._should_bail(): return dmg
	await gym1_hit_active(attacker, defender, is_opponent, dmg)
	if main._should_bail(): return dmg
	await main.check_all_knockouts()
	return dmg

# POLTERGEIST (Gengar ex): look at the opponent's hand; base + `per` for each Trainer card in it.
func execute_ex6_poltergeist(attacker: card_object, defender: card_object, is_opponent: bool, base_damage: int, per: int) -> int:
	if await handle_attack_confusion(attacker, is_opponent): return 0
	if await handle_attack_blind(attacker, is_opponent): return 0
	var opp_hand = main.player_hand if is_opponent else main.opponent_hand
	await _reveal_opp_hand(is_opponent, "POLTERGEIST")
	if main._should_bail(): return 0
	var trainers = 0
	for c in opp_hand:
		if c.metadata.get("supertype","") == "Trainer":
			trainers += 1
	var dmg = base_damage + per * trainers
	await main.show_message("POLTERGEIST! " + str(trainers) + " TRAINER(S) IN HAND — " + str(dmg) + " DAMAGE!")
	if main._should_bail(): return dmg
	await gym1_hit_active(attacker, defender, is_opponent, dmg)
	if main._should_bail(): return dmg
	await main.check_all_knockouts()
	return dmg

# BREAKDOWN (Mr. Mime ex): put damage counters on the Defender equal to the number of cards in the
# opponent's hand.
func execute_ex6_breakdown(attacker: card_object, defender: card_object, is_opponent: bool) -> void:
	if await handle_attack_confusion(attacker, is_opponent): return
	if await handle_attack_blind(attacker, is_opponent): return
	var opp_hand = main.player_hand if is_opponent else main.opponent_hand
	var n = opp_hand.size()
	if defender != null and n > 0:
		await gym1_place_counters(defender, n * 10, not is_opponent)   # ISSUE #330: honours Agility-style protection
		if main._should_bail(): return
		await main.show_message("BREAKDOWN! PUT " + str(n) + " DAMAGE COUNTERS ON THE DEFENDING POKEMON!")
		if main._should_bail(): return
	await main.check_all_knockouts()

# Legendary-bird ex discard-energy attacks: base damage, then you may discard an Energy from the
# attacker; if you do, apply `mode` ("opp_discard" | "confuse" | "bonus").
func execute_ex6_optional_discard_effect(attacker: card_object, defender: card_object, is_opponent: bool, base_damage: int, mode: String, bonus: int) -> int:
	if await handle_attack_confusion(attacker, is_opponent): return 0
	if await handle_attack_blind(attacker, is_opponent): return 0
	var do_discard = false
	var cpu_e: card_object = null
	if not attacker.attached_energies.is_empty():
		if is_opponent:
			# ISSUE #325: CPU used to discard whenever it had 4+ Energy (and always for a bonus) and threw away the
			# LAST card attached. Now it gives up its least valuable Energy, and only for a KO, when going down
			# anyway, or when that Energy is spare and the effect does something.
			cpu_e = await r4_pick_own_energy(attacker, attacker.attached_energies.duplicate(), true, "")
			var gives_ko = mode == "bonus" and r4_would_ko(attacker, defender, base_damage + bonus) and not r4_would_ko(attacker, defender, base_damage)
			var effect_lands = defender != null and (mode == "bonus" or (mode in ["opp_discard", "atk_discard"] and not defender.attached_energies.is_empty()) or (mode == "confuse" and defender.special_condition != "Confused"))
			do_discard = r4_cpu_spend_energy(attacker, cpu_e, gives_ko, effect_lands)
		else:
			var e_pick = await main.card_ops.choose_card(attacker.attached_energies.duplicate(), false, "DISCARD ENERGY?", "Discard an Energy for the bonus effect? (Cancel to skip)", "DISCARD", true)
			if main._should_bail(): return 0
			if e_pick != null:
				main.card_ops.discard_energy_from_pokemon(e_pick, false)
				main.display_active_pokemon_energies(false)
				main.update_discard_pile_display(false)
				do_discard = true
	if is_opponent and do_discard:
		main.card_ops.discard_energy_from_pokemon(cpu_e, true)
		main.display_active_pokemon_energies(true)
		main.update_discard_pile_display(true)
	var dmg = base_damage + (bonus if (do_discard and mode == "bonus") else 0)
	await gym1_hit_active(attacker, defender, is_opponent, dmg)
	if main._should_bail(): return dmg
	if do_discard and defender != null and defender.current_hp > 0:
		if mode in ["opp_discard", "atk_discard"] and not defender.attached_energies.is_empty():
			# "your opponent discards" = defender picks; "discard an Energy attached to the Defending" = attacker picks
			await main.card_ops.remove_one_energy(defender, not is_opponent, (not is_opponent) if mode == "opp_discard" else is_opponent)
			if main._should_bail(): return dmg
		elif mode == "confuse":
			main.card_ops.apply_status(defender, "Confused", not is_opponent)
			await main.show_message("THE DEFENDING POKEMON IS NOW CONFUSED!")
			if main._should_bail(): return dmg
	await main.check_all_knockouts()
	return dmg

