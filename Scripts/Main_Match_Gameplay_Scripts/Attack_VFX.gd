var _last_hit_sound := -10.0
var _shake_users := 0
var _shake_base := Vector2.ZERO


## A countdown other coroutines can wait on: add() per job started, finish() per job done.
class _Join extends RefCounted:
	signal done
	var n := 0
	func add() -> void:
		n += 1
	func finish() -> void:
		n -= 1
		if n <= 0:
			done.emit()
	func wait_all() -> void:
		if n > 0:
			await done


## One playing recipe.
class _Ctx extends RefCounted:
	signal bumped
	var attacker: card_object
	var defender: card_object
	var recipe: Dictionary
	var elem: Dictionary = {}
	var a_rect: Rect2
	var d_rect: Rect2
	var dir: Vector2 = Vector2.RIGHT
	var react: Dictionary = {}
	var impact_done := false
	var did_bump := false
	var jobs: _Join = _Join.new()      # reactions, screen effects -- waited for before the play ends
	var sprites: Array = []
	var sfx_start: AudioStreamPlayer = null   # the build-up, cut when the impact lands
	var sfx_plan: Dictionary = {}             # what plays at the impact


func _ready() -> void:
	_layer = Node2D.new()
	_layer.name = "AttackVFXLayer"
	_layer.z_index = FX_Z
	_layer.z_as_relative = false
	main.add_child(_layer)
	_manifest = _load_json("vfx_manifest.json")
	var r: Dictionary = _load_json("vfx_recipes.json")
	_recipes = r.get("recipes", {})
	_status = r.get("status", {})
	_fallback = r.get("fallback", {})
	_utility = r.get("utility", {})
	_elements = r.get("elements", {})
	_map = _load_json("attack_vfx_map.json")
	_sfx = _load_json("sfx_manifest.json")
	_sounds = r.get("sounds", {})
	_hue_shader = Shader.new()
	_hue_shader.code = HUE_SHADER
	print("ATTACK VFX: ", _manifest.size(), " effect parts, ", _recipes.size(), " recipes, ", _map.size(), " attacks")


func _load_json(file: String) -> Dictionary:
	var f := FileAccess.open(DATA_DIR + file, FileAccess.READ)
	if f == null:
		push_warning("ATTACK VFX: missing " + DATA_DIR + file)
		return {}
	var d = JSON.parse_string(f.get_as_text())
	return d if d is Dictionary else {}


# ============================================================
# ENTRY POINTS (main)
# ============================================================

## The attack has just been declared. Remember it for the hit that follows.
func set_pending(attacker: card_object, attack: Dictionary) -> void:
	_pending = {"attacker": attacker, "attack": attack, "turn": main.turn_number, "played": false}


## The pending attack for this hit, if it belongs to `attacker` and this turn -- and it is used up.
func take_pending(attacker: card_object, defender: card_object) -> Dictionary:
	if _pending.is_empty() or attacker == null or defender == null or attacker == defender:
		return {}
	if _pending["attacker"] != attacker or int(_pending["turn"]) != main.turn_number:
		return {}
	var p := _pending
	_pending = {}
	return p


## A non-damaging attack: plays at the "X used Y!" beat. False when there is nothing to play, so the
## caller falls back to the Card_FX gesture.
func play_intent(attacker: card_object, defender: card_object, attack: Dictionary) -> bool:
	if not _enabled():
		return false
	var recipe := recipe_for(attacker, attack)
	if recipe.is_empty():
		return false
	if not _pending.is_empty() and _pending["attacker"] == attacker:
		_pending["played"] = true
	_last_play = {"recipe": recipe, "attacker": attacker, "turn": main.turn_number}
	print("ATTACK VFX: intent '", attack.get("name", ""), "' -> ", recipe.get("_id", "?"))
	await play(attacker, defender, recipe, {})
	return true


## A damaging hit. `pend` comes from take_pending().
func play_hit(attacker: card_object, defender: card_object, pend: Dictionary, damage: int, weak: bool, resisted: bool) -> void:
	var react := {"damage": damage, "weak": weak, "resisted": resisted}
	if not _enabled():
		await main.attack_hit_motion(attacker, defender, damage, weak, resisted, true)
		return
	var recipe := recipe_for(attacker, pend["attack"])
	if not recipe.is_empty():
		_last_play = {"recipe": recipe, "attacker": attacker, "turn": main.turn_number}
	if bool(pend.get("played", false)) or recipe.is_empty():
		# The effect already played at the declare beat (an attack whose damage is all in its text):
		# only the defender's reaction now.
		var ctx := _make_ctx(attacker, defender, recipe if not recipe.is_empty() else {"react": "knock"}, react)
		if ctx != null:
			_impact(ctx)
			await ctx.jobs.wait_all()
		return
	print("ATTACK VFX: hit '", pend["attack"].get("name", ""), "' -> ", recipe.get("_id", "?"), " damage ", damage)
	await play(attacker, defender, recipe, react)


## A benched Pokémon has just taken `damage` (Card_Ops.apply_bench_damage). Plays a small copy of the
## attack's effect on it while it flashes and shakes in the attack's element colour. Returns once the
## hit has landed (the rest plays on), and never sooner than BENCH_GAP after the previous bench hit
## started, so a whole bench goes off one card at a time.
func bench_hit(pokemon: card_object, damage: int, from_attack: bool) -> void:
	if not _enabled() or pokemon == null:
		return
	var now := Time.get_ticks_msec() / 1000.0
	var start := maxf(now, _bench_next)
	_bench_next = start + GameState.match_time(BENCH_GAP)
	if start > now:
		await get_tree().create_timer(start - now).timeout
		if _bail():
			return
	var src: Dictionary = {}
	if from_attack and not _last_play.is_empty() and int(_last_play["turn"]) == main.turn_number:
		src = _last_play["recipe"]
	var step := _bench_step(src)
	var mini := {"_id": "bench " + str(src.get("_id", "hit")), "body": "none", "react": "shake", "_bench": true,
		"element": src.get("element", "normal"), "steps": [step] if not step.is_empty() else []}
	# Any card on the other side will do as the "attacker": it only sets which way the effect faces.
	var other: card_object = main.player_active_pokemon if pokemon.is_owner_opp(main) else main.opponent_active_pokemon
	if _last_play.has("attacker") and _last_play["attacker"] != null and _last_play["attacker"] != pokemon:
		other = _last_play["attacker"]
	if other == null or other == pokemon:
		other = main.opponent_active_pokemon if pokemon.is_owner_opp(main) else main.player_active_pokemon
	print("ATTACK VFX: bench hit on ", pokemon.metadata.get("name", "?"), " -> ", step.get("fx", "-"))
	play(other if other != pokemon else null, pokemon, mini, {"damage": damage})
	await _wait(BENCH_LEAD)


## The effect a bench hit plays: the recipe's own "bench_fx", or a smaller copy of its first
## target-side effect, or a plain impact burst.
func _bench_step(recipe: Dictionary) -> Dictionary:
	var s: Dictionary = {}
	if recipe.has("bench_fx"):
		s = (recipe["bench_fx"] as Dictionary).duplicate()
	else:
		for st in recipe.get("steps", []):
			if str(st.get("at", "")) in ["target", "drop", "screen"] and st.has("fx"):
				s = (st as Dictionary).duplicate()
				s["size"] = minf(float(s.get("size", 1.0)), 1.1) * BENCH_SIZE
				break
	if s.is_empty():
		s = {"fx": "QuickBurst", "size": 0.8}
	s["at"] = "target"
	for k in ["par", "delay", "count", "stagger", "jitter", "time", "impact"]:
		s.erase(k)
	if s.has("anchor") and str(s["anchor"]) == "bottom":
		s["off"] = [0.0, 0.45]
	return s


## A Special Condition has landed on `card` (Card_FX.status). Fire and forget.
func play_status(card: card_object, kind: String) -> void:
	if not _enabled() or not _status.has(kind):
		return
	var recipe: Dictionary = _status[kind].duplicate()
	recipe["_id"] = "status " + kind
	await play(card, card, recipe, {})


## The debugger: `name` exactly as the map has it, played with the attack's own type and cost, then its
## first Special Condition. Ignores reduce-motion so it can always be seen.
func preview_attack(name: String, attacker: card_object, defender: card_object) -> void:
	var info: Dictionary = _map.get(name, {})
	var recipe := recipe_by_name(name, str(info.get("type", "Colorless")), int(info.get("cost", 1)))
	var react := {"damage": PREVIEW_DAMAGE} if bool(info.get("dmg", false)) else {}
	print("ATTACK VFX: preview '", name, "' -> ", recipe.get("_id", "?"))
	_last_play = {"recipe": recipe, "attacker": attacker, "turn": main.turn_number}
	await play(attacker, defender, recipe, react)
	# Attacks that damage the Bench: each of the defender's benched Pokémon takes its hit in turn.
	if bool(info.get("bench", false)) or recipe.has("bench_fx"):
		_bench_next = 0.0
		for card in _bench_of(defender):
			await bench_hit(card, PREVIEW_DAMAGE, true)
		await _wait(0.5)
	var st: Array = info.get("status", [])
	if not st.is_empty():
		await preview_status(defender, str(st[0]))


func preview_status(card: card_object, kind: String) -> void:
	if not _status.has(kind):
		return
	if main.card_fx != null:
		main.card_fx.status(card, kind)   # the card's own sway / tint -- which also plays the overlay
		await _wait(1.0)
	else:
		var recipe: Dictionary = _status[kind].duplicate()
		await play(card, card, recipe, {})


func _enabled() -> bool:
	return main != null and not _manifest.is_empty() and not GameState.is_motion_reduced() \
		and GameState.match_time(1.0) > 0.02


# ============================================================
# CHOOSING A RECIPE
# ============================================================

func recipe_for(attacker: card_object, attack: Dictionary) -> Dictionary:
	var name := str(attack.get("name", "")).strip_edges()
	var types: Array = attacker.get_effective_types() if attacker != null else []
	var t: String = str(types[0]) if not types.is_empty() else "Colorless"
	var cost := int(attack.get("convertedEnergyCost", (attack.get("cost", []) as Array).size()))
	return recipe_by_name(name, t, cost)


## Also used by the debugger, with the attack's own type and cost from the map.
func recipe_by_name(name: String, type: String, cost: int) -> Dictionary:
	var m: Dictionary = _map.get(name, {})
	var rid := str(m.get("fx", "@type"))
	var by_type: Dictionary = m.get("by_type", {})
	if by_type.has(type):
		rid = str(by_type[type])
	if rid == "@type":
		rid = _type_fallback(type, cost, str(m.get("style", "spec")), bool(m.get("dmg", true)))
	var r := recipe_by_id(rid)
	# An attack that is a real game move plays that move's own sound, whatever it looks like.
	if not r.is_empty() and m.has("sfx"):
		r["_sfx"] = str(m["sfx"])
		r.erase("sfx_pitch")
	return r


func recipe_by_id(rid: String) -> Dictionary:
	if not _recipes.has(rid):
		return {}
	var r: Dictionary = _recipes[rid].duplicate()
	r["_id"] = rid
	return r


func _type_fallback(type: String, cost: int, style: String, damaging: bool) -> String:
	if not damaging:
		return str(_utility.get("other", "Glitter"))
	var f: Dictionary = _fallback.get(type, _fallback.get("Colorless", {}))
	var tiers: Array = f.get(style, f.get("spec", []))
	if tiers.is_empty():
		return "Tackle"
	return str(tiers[clampi(0 if cost <= 1 else (1 if cost == 2 else 2), 0, tiers.size() - 1)])


## Debugger / map lookups.
func attack_names() -> Array:
	var names := _map.keys()
	names.sort_custom(func(a, b): return str(a).naturalnocasecmp_to(str(b)) < 0)
	return names

func attack_info(name: String) -> Dictionary:
	return _map.get(name, {})

func recipe_ids() -> Array:
	var ids := _recipes.keys()
	ids.sort_custom(func(a, b): return str(a).naturalnocasecmp_to(str(b)) < 0)
	return ids

func status_kinds() -> Array:
	return _status.keys()


# ============================================================
# PLAYING A RECIPE
# ============================================================

func _make_ctx(attacker: card_object, defender: card_object, recipe: Dictionary, react: Dictionary) -> _Ctx:
	var ctx := _Ctx.new()
	ctx.attacker = attacker
	ctx.defender = defender if defender != null else attacker
	ctx.recipe = recipe
	ctx.elem = _elements.get(str(recipe.get("element", "normal")), {})
	ctx.a_rect = _card_rect(attacker)
	ctx.d_rect = _card_rect(ctx.defender)
	ctx.react = react
	if ctx.a_rect.size == Vector2.ZERO and ctx.d_rect.size == Vector2.ZERO:
		return null
	if ctx.a_rect.size == Vector2.ZERO:
		ctx.a_rect = ctx.d_rect
	if ctx.d_rect.size == Vector2.ZERO:
		ctx.d_rect = ctx.a_rect
	var d: Vector2 = ctx.d_rect.get_center() - ctx.a_rect.get_center()
	if d.length() > 1.0:
		ctx.dir = d.normalized()
	elif attacker.is_owner_opp(main):
		ctx.dir = Vector2.LEFT   # a status on the opponent's card: face their way
	return ctx


## Plays `recipe` from `attacker` at `defender`. `react` is {"damage", "weak", "resisted"} for a hit
## (the defender is knocked back at the impact), or empty for none.
func play(attacker: card_object, defender: card_object, recipe: Dictionary, react: Dictionary) -> void:
	if attacker == null or recipe.is_empty():
		return
	var ctx := _make_ctx(attacker, defender, recipe, react)
	if ctx == null:
		return
	var steps: Array = recipe.get("steps", [])
	var body := str(recipe.get("body", "none"))
	var contact := body in CONTACT_BODIES and ctx.defender != attacker and _both_active(attacker, ctx.defender)
	var est := _estimate(steps)
	var screen: Dictionary = recipe.get("screen", {})
	var dim_rect: ColorRect = null
	if screen.has("dim"):
		dim_rect = _dim_start(ctx, float(screen["dim"]), est + 0.8)
	_sfx_begin(ctx, steps, body, contact, est)

	if contact:
		await _play_contact(ctx, steps, body)
	else:
		_body_motion(ctx, body, est)
		await _run_groups(ctx, steps)
		# A hit that never reached a target-side step (a power-up recipe on a damaging attack) still lands.
		_impact(ctx)
	await ctx.jobs.wait_all()
	if dim_rect != null:
		await _dim_end(dim_rect)
	_cleanup(ctx)


## Contact: self-side steps first, then the attacker darts in; target steps fire on the bump.
func _play_contact(ctx: _Ctx, steps: Array, body: String) -> void:
	var first_out := steps.size()
	for i in steps.size():
		if str(steps[i].get("at", "")) != "self":
			first_out = i
			break
	if first_out > 0:
		_glow(ctx.attacker, ctx, _estimate(steps.slice(0, first_out)), GLOW_ATTACK)
	await _run_groups(ctx, steps.slice(0, first_out))
	var rest: Array = steps.slice(first_out)
	# Travel steps (a comet trail, a shadow) fly alongside the dart; everything after waits for the bump.
	var travel: Array = []
	while not rest.is_empty() and str(rest[0].get("at", "")) in ["travel", "return", "beam"]:
		travel.append(rest.pop_front())
	var motion := _Join.new()
	motion.add()
	_contact_motion(ctx, body, motion)
	if not travel.is_empty():
		_run_groups(ctx, travel)
	if not ctx.did_bump:
		await ctx.bumped
	_impact(ctx)
	await _run_groups(ctx, rest)
	await motion.wait_all()


# ============================================================
# ATTACKER BODIES
# ============================================================

## The dart-and-bump family. Emits ctx.bumped the moment the cards touch.
func _contact_motion(ctx: _Ctx, body: String, motion: _Join) -> void:
	var fx = main.card_fx
	var a_c: Vector2 = ctx.a_rect.get_center()
	var d_c: Vector2 = ctx.d_rect.get_center()
	var dir := ctx.dir
	var reach: float = absf(dir.x) * (ctx.a_rect.size.x + ctx.d_rect.size.x) / 2.0 \
		+ absf(dir.y) * (ctx.a_rect.size.y + ctx.d_rect.size.y) / 2.0
	var travel: float = maxf(0.0, a_c.distance_to(d_c) - reach + OVERLAP_PX)
	var hit_at := dir * travel
	var tilt: float = TILT * (1.0 if dir.x >= 0.0 else -1.0)
	var recoil := bool(ctx.recipe.get("recoil", false))
	var glow: Color = _elem_colour(ctx, "glow", Color.WHITE)
	var times: Array = LUNGE_TIMES
	match body:
		"dash": times = DASH_TIMES
		"spin": times = SPIN_TIMES
		"leap": times = LEAP_TIMES
		"dive": times = DIVE_TIMES
		"vanish_strike": times = VANISH_TIMES
	var parts: Array = []
	var total := 0.0
	for t in times:
		var s := GameState.match_time(float(t))
		parts.append(s)
		total += s
	var bump_at: float = total - float(parts[-1])   # the return is always the last phase
	var ghosted: Array = [0]   # afterimages already dropped (an Array so the lambda can change it)
	var fire_bump := func():
		if not ctx.did_bump:
			ctx.did_bump = true
			ctx.bumped.emit()
	var fn := func(e: Dictionary, f: float) -> void:
		var t := f * total
		e["z"] = 6
		if t >= bump_at:
			fire_bump.call()
			var r := clampf((t - bump_at) / maxf(float(parts[-1]), 0.001), 0.0, 1.0)
			var back := _ease_out_back(r)
			if recoil:
				# Bounced well past home, then settles: hurt by its own attack.
				var over := -dir * RECOIL_PX * sin(r * PI)
				e["offset"] = hit_at.lerp(Vector2.ZERO, clampf(r * 1.6, 0.0, 1.0)) + over
				e["tint"] = Color.WHITE.lerp(Color(1.6, 0.7, 0.7), sin(r * PI) * 0.8)
			else:
				e["offset"] = hit_at.lerp(Vector2.ZERO, back)
			e["rot"] = lerpf(tilt, 0.0, r)
			if body == "leap":
				e["offset"] += Vector2(0, -40.0 * sin(r * PI))
			e["alpha"] = 1.0
			e["scale"] = Vector2.ONE
			return
		match body:
			"leap":
				var c: float = parts[0]
				if t < c:
					var p := t / c
					e["offset"] = Vector2(0, 6.0 * p)
					e["scale"] = Vector2(1.0 + 0.06 * p, 1.0 - 0.09 * p)
					e["tint"] = Color.WHITE.lerp(glow, 0.3 * p)
				else:
					var p := (t - c) / float(parts[1])
					e["offset"] = Vector2.ZERO.lerp(hit_at, p) + Vector2(0, -LEAP_ARC * sin(p * PI))
					e["scale"] = Vector2.ONE
					e["rot"] = tilt * p
			"dive":
				var p0: float = parts[0]
				var p1: float = parts[1]
				if t < p0:
					var p := _ease_out(t / p0)
					e["offset"] = Vector2(0, -DIVE_HEIGHT * p)
					e["scale"] = Vector2.ONE * lerpf(1.0, 0.85, p)
				elif t < p0 + p1:
					e["offset"] = Vector2(0, -DIVE_HEIGHT + 4.0 * sin((t - p0) * 30.0))
				else:
					var p := (t - p0 - p1) / float(parts[2])
					e["offset"] = Vector2(0, -DIVE_HEIGHT).lerp(hit_at, p * p)
					e["scale"] = Vector2.ONE * lerpf(0.85, 1.0, p)
					e["rot"] = tilt * 1.6 * p
					_afterimage_step(ctx, ghosted, p)
			"vanish_strike":
				var p0: float = parts[0]
				if t < p0:
					e["alpha"] = 1.0 - t / p0
				elif t < p0 + float(parts[1]):
					e["alpha"] = 0.0
					e["offset"] = hit_at - dir * 30.0
				else:
					var p := (t - p0 - float(parts[1])) / float(parts[2])
					e["alpha"] = p
					e["offset"] = (hit_at - dir * 30.0).lerp(hit_at, p)
					e["rot"] = tilt
			_:   # lunge / dash / spin
				var w: float = parts[0]
				if t < w:
					var p := sin(t / w * PI / 2.0)
					e["offset"] = -dir * WINDUP_PX * p
					e["rot"] = tilt * p
					e["tint"] = Color.WHITE.lerp(glow, 0.25 * p)
				else:
					var p := (t - w) / float(parts[1])
					e["offset"] = (-dir * WINDUP_PX).lerp(hit_at, p * p)
					e["rot"] = tilt if body != "spin" else tilt + TAU * 2.0 * p
					if body == "dash":
						_afterimage_step(ctx, ghosted, p)
	if fx == null:
		fire_bump.call()
	else:
		await fx.motion(ctx.attacker, total, fn)
	fire_bump.call()
	motion.finish()


## Drops up to AFTERIMAGES fading copies of the attacker along its dart (p = 0..1 of the dart).
func _afterimage_step(ctx: _Ctx, done: Array, p: float) -> void:
	var want := int(p * float(AFTERIMAGES + 1))
	while int(done[0]) < mini(want, AFTERIMAGES):
		done[0] = int(done[0]) + 1
		_afterimage(ctx)


func _afterimage(ctx: _Ctx) -> void:
	var g: TextureRect = main.card_fx.ghost_of(ctx.attacker) if main.card_fx != null else null
	if g == null or not is_instance_valid(g):
		return
	var a := TextureRect.new()
	a.texture = g.texture
	a.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	a.stretch_mode = g.stretch_mode
	a.mouse_filter = Control.MOUSE_FILTER_IGNORE
	a.size = g.size
	a.pivot_offset = g.pivot_offset
	a.position = g.position
	a.rotation = g.rotation
	a.z_index = AFTERIMAGE_Z
	a.z_as_relative = false
	var c: Color = _elem_colour(ctx, "glow", Color(0.8, 0.9, 1.0))
	a.modulate = Color(c.r, c.g, c.b, AFTERIMAGE_ALPHA)
	main.add_child(a)
	var tw := a.create_tween()
	tw.tween_property(a, "modulate:a", 0.0, GameState.match_time(AFTERIMAGE_FADE))
	tw.tween_callback(a.queue_free)


## On-the-spot bodies, sized to the effects (`est` base seconds).
func _body_motion(ctx: _Ctx, body: String, est: float) -> void:
	var fx = main.card_fx
	if fx == null or ctx.attacker == null or body in ["none", ""]:
		return
	var self_only := ctx.defender == ctx.attacker or _all_self(ctx.recipe.get("steps", []))
	var glow: Color = _elem_colour(ctx, "glow", Color.WHITE)
	var glow_amt: float = GLOW_SELF if self_only else GLOW_ATTACK
	if ctx.attacker == ctx.defender:
		glow_amt = 0.0   # a status overlay: the card's own status animation does the colour
	var dur := GameState.match_time(maxf(est, 0.3))
	var hops := int(ctx.recipe.get("hops", 2))
	var fn: Callable
	match body:
		"hop":
			dur = GameState.match_time(HOP_TIME * 2.0 * hops)
			fn = func(e: Dictionary, f: float) -> void:
				e["offset"] = Vector2(0.0, -absf(sin(f * float(hops) * PI)) * HOP_PX)
				e["scale"] = Vector2(1.0 - 0.03 * sin(f * float(hops) * TAU), 1.0 + 0.03 * sin(f * float(hops) * TAU))
				e["tint"] = Color.WHITE.lerp(glow, glow_amt * sin(f * PI))
		"sway":
			fn = func(e: Dictionary, f: float) -> void:
				e["offset"] = Vector2(sin(f * TAU) * SWAY_PX, 0.0)
				e["rot"] = sin(f * TAU) * 0.04
				e["tint"] = Color.WHITE.lerp(glow, glow_amt * sin(f * PI))
		"shake":
			fn = func(e: Dictionary, f: float) -> void:
				var amp := SHAKE_PX * sin(f * PI)
				e["offset"] = Vector2(sin(f * 90.0) * amp, cos(f * 70.0) * amp * 0.4)
				e["tint"] = Color.WHITE.lerp(glow, glow_amt * sin(f * PI))
		"charge":
			fn = func(e: Dictionary, f: float) -> void:
				var up := clampf(f / 0.6, 0.0, 1.0)
				var down := clampf((1.0 - f) / 0.15, 0.0, 1.0)
				var amp := minf(up, down)
				e["offset"] = Vector2(sin(f * 120.0) * 3.0 * amp, 0.0)
				e["scale"] = Vector2.ONE * lerpf(1.0, CHARGE_GROW, amp)
				e["tint"] = Color.WHITE.lerp(glow, maxf(glow_amt, 0.6) * amp)
		"grow":
			fn = func(e: Dictionary, f: float) -> void:
				var a := sin(f * PI)
				e["scale"] = Vector2.ONE * lerpf(1.0, GROW_TO, a)
				e["offset"] = Vector2(0, -6.0 * a)
				e["tint"] = Color.WHITE.lerp(glow, glow_amt * a)
		"shrink":
			fn = func(e: Dictionary, f: float) -> void:
				var a := clampf(minf(f / 0.25, (1.0 - f) / 0.25), 0.0, 1.0)
				e["scale"] = Vector2.ONE * lerpf(1.0, SHRINK_TO, a)
				e["tint"] = Color.WHITE.lerp(glow, glow_amt * a)
		"rise":
			fn = func(e: Dictionary, f: float) -> void:
				var a := _ease_out(clampf(minf(f / 0.25, (1.0 - f) / 0.25), 0.0, 1.0))
				e["offset"] = Vector2(0, -RISE_PX * a + sin(f * 14.0) * 3.0 * a)
				e["tint"] = Color.WHITE.lerp(glow, glow_amt * a)
		"vanish":
			fn = func(e: Dictionary, f: float) -> void:
				e["alpha"] = clampf(maxf(1.0 - f / 0.18, (f - 0.82) / 0.18), 0.0, 1.0)
				e["scale"] = Vector2(lerpf(1.0, 0.7, 1.0 - e["alpha"]), 1.0)
		_:
			return
	fx.motion(ctx.attacker, dur, fn)


## A tint pulse on `card` (the attacker charging) for `est` base seconds.
func _glow(card: card_object, ctx: _Ctx, est: float, amount: float) -> void:
	if main.card_fx == null or card == null or est <= 0.0:
		return
	var glow: Color = _elem_colour(ctx, "glow", Color.WHITE)
	main.card_fx.motion(card, GameState.match_time(est), func(e: Dictionary, f: float) -> void:
		e["tint"] = Color.WHITE.lerp(glow, amount * sin(f * PI)))


# ============================================================
# DEFENDER REACTIONS
# ============================================================

## The defender reacts once, when the first impact step starts (or on the bump).
func _impact(ctx: _Ctx) -> void:
	if ctx.impact_done:
		return
	ctx.impact_done = true
	_sfx_impact(ctx)
	var screen: Dictionary = ctx.recipe.get("screen", {})
	if screen.has("flash"):
		_screen_flash(ctx, Color(str(screen["flash"])))
	if screen.has("shake"):
		_screen_shake(ctx, float(screen["shake"]))
	if ctx.defender == null or ctx.defender == ctx.attacker:
		return
	ctx.jobs.add()
	_react_now(ctx)


func _react_now(ctx: _Ctx) -> void:
	await _react(ctx)
	ctx.jobs.finish()


func _react(ctx: _Ctx) -> void:
	var fx = main.card_fx
	if fx == null:
		return
	var hit := not ctx.react.is_empty()
	var damage := int(ctx.react.get("damage", 0))
	var weak := bool(ctx.react.get("weak", false))
	var resisted := bool(ctx.react.get("resisted", false))
	var mult: float = WEAK_MULT if weak else (RESIST_MULT if resisted else 1.0)
	var style := str(ctx.recipe.get("react", "knock"))
	if str(ctx.recipe.get("power", "")) == "heavy":
		mult *= HEAVY_MULT
	var moving := hit and damage > 0
	if not moving:
		style = "none"
	# Colour: the hit flash, then the element's lingering tint. Weakness / Resistance keep their colours.
	var flash: Color = _elem_colour(ctx, "flash", FLASH_PLAIN)
	if weak:
		flash = FLASH_WEAK
	elif resisted:
		flash = FLASH_RESIST if damage > 0 else FLASH_ZERO_RESIST
	var flashing := hit and (damage > 0 or resisted)
	var linger: Color = _elem_colour(ctx, "linger", Color.WHITE)
	var linger_mode := str(ctx.elem.get("linger_mode", "fade"))
	var linger_time := float(ctx.elem.get("linger_time", 0.0))
	if not bool(ctx.recipe.get("linger", true)) or not ctx.elem.has("linger"):
		linger_time = 0.0
	if not hit and linger_time <= 0.0:
		return
	if not hit:
		linger_time = maxf(linger_time, 0.5)
	var hits := maxi(1, int(ctx.recipe.get("hits", 1)))
	var dir := ctx.dir
	var kb := dir * KNOCK_PX * mult
	var style_time := 0.0
	match style:
		"none": style_time = 0.0
		"multi": style_time = MULTI_GAP * float(hits) + KNOCK_SETTLE
		"spin": style_time = 0.55
		"lift": style_time = 0.6
		"squash", "squeeze": style_time = 0.5
		"jolt", "shake": style_time = 0.55
		"freeze": style_time = 0.3
		_: style_time = KNOCK_OUT + maxf(KNOCK_SETTLE, WIGGLE_STEP * WIGGLE.size())
	var base_total := maxf(style_time, (FLASH_FADE if flashing else 0.0) + linger_time)
	if base_total <= 0.0:
		return
	var total := GameState.match_time(base_total)
	var fn := func(e: Dictionary, f: float) -> void:
		var t := f * base_total   # base seconds, so the shapes below read in the TWEAKABLE units
		# ---- motion ----
		var off := Vector2.ZERO
		var rot := 0.0
		var sc := Vector2.ONE
		match style:
			"knock":
				off = _knock(kb, t)
				rot = _wiggle(t, mult)
			"multi":
				for i in hits:
					var ti := t - MULTI_GAP * float(i)
					if ti >= 0.0:
						off += _knock(kb * 0.55, ti)
				rot = _wiggle(t - MULTI_GAP * float(hits - 1), mult * 0.7)
			"spin":
				off = _knock(kb, t)
				rot = TAU * _ease_out(clampf(t / 0.5, 0.0, 1.0))
			"lift":
				if t < 0.2:
					off = Vector2(0, -LIFT_PX * _ease_out(t / 0.2))
					rot = 0.1 * (t / 0.2)
				elif t < 0.28:
					off = Vector2(0, -LIFT_PX)
					rot = 0.1
				elif t < 0.36:
					var p := (t - 0.28) / 0.08
					off = Vector2(0, -LIFT_PX * (1.0 - p * p))
					rot = 0.1 * (1.0 - p)
				else:
					var p := clampf((t - 0.36) / 0.24, 0.0, 1.0)
					sc = Vector2(1.0 + 0.12 * (1.0 - p) * cos(p * 9.0), 1.0 - 0.16 * (1.0 - p) * cos(p * 9.0))
					off = Vector2(0, 4.0 * (1.0 - p))
			"squash":
				var p := clampf(t / 0.5, 0.0, 1.0)
				var k := (1.0 - p) * cos(p * 12.0)
				sc = Vector2(1.0 + 0.18 * k * mult * 0.7, 1.0 - 0.24 * k * mult * 0.7)
				off = _knock(kb * 0.5, t) + Vector2(0, 10.0 * maxf(k, 0.0))
			"squeeze":
				var p := clampf(t / 0.5, 0.0, 1.0)
				sc = Vector2(1.0 - 0.14 * absf(sin(p * TAU)) * (1.0 - p * 0.5), 1.0 + 0.04 * absf(sin(p * TAU)))
			"jolt":
				var i := int(t / JOLT_STEP)
				var amp := JOLT_PX * mult * clampf(1.0 - t / 0.55, 0.0, 1.0)
				off = Vector2(amp if i % 2 == 0 else -amp, (amp * 0.3) if i % 3 == 0 else 0.0)
			"shake":
				var amp := 6.0 * mult * clampf(1.0 - t / 0.55, 0.0, 1.0)
				off = Vector2(sin(t * 60.0) * amp, cos(t * 47.0) * amp * 0.5)
			"freeze":
				var amp := 3.0 * clampf(1.0 - t / 0.3, 0.0, 1.0)
				off = Vector2(sin(t * 80.0) * amp, 0.0)
		e["offset"] = off
		e["rot"] = rot
		e["scale"] = sc
		# ---- colour ----
		var col := Color.WHITE
		var lt := t
		if flashing:
			if t < FLASH_IN:
				col = flash
			elif t < FLASH_FADE:
				col = flash.lerp(_linger_at(linger, linger_mode, 0.0, linger_time), (t - FLASH_IN) / (FLASH_FADE - FLASH_IN))
			lt = t - FLASH_FADE
		if lt >= 0.0 and (not flashing or t >= FLASH_FADE):
			col = _linger_at(linger, linger_mode, lt, linger_time)
		if style == "multi" and flashing:
			for i in range(1, hits):
				var ti := t - MULTI_GAP * float(i)
				if ti >= 0.0 and ti < FLASH_IN:
					col = flash
		e["tint"] = col
	await fx.motion(ctx.defender, total, fn)


func _knock(kb: Vector2, t: float) -> Vector2:
	if t <= 0.0:
		return Vector2.ZERO
	if t < KNOCK_OUT:
		return kb * _ease_out(t / KNOCK_OUT)
	var p := clampf((t - KNOCK_OUT) / KNOCK_SETTLE, 0.0, 1.0)
	return kb * (1.0 - (0.5 - 0.5 * cos(p * PI)))


func _wiggle(t: float, mult: float) -> float:
	var s := t - KNOCK_OUT
	if s < 0.0:
		return 0.0
	var i := int(s / WIGGLE_STEP)
	if i >= WIGGLE.size() - 1:
		return 0.0
	var fr := (s - float(i) * WIGGLE_STEP) / WIGGLE_STEP
	return lerpf(float(WIGGLE[i]), float(WIGGLE[i + 1]), fr) * mult


## The lingering element tint `t` seconds after the flash.
func _linger_at(c: Color, mode: String, t: float, dur: float) -> Color:
	if dur <= 0.0:
		return Color.WHITE
	var k := clampf(1.0 - t / dur, 0.0, 1.0)
	match mode:
		"flicker":
			k *= 1.0 if int(t / 0.06) % 2 == 0 else 0.25
		"pulse":
			k *= 0.55 + 0.45 * cos(t * 12.0)
	return Color.WHITE.lerp(c, k)


# ============================================================
# SOUND
# ============================================================
# Every recipe has a Gen 4 move clip ("sfx"; an attack that IS a game move overrides it with its own,
# "_sfx"). Each clip knows where its main hit lands ("hit", from attack_sfx_import.py), so:
#   - a clip with a build-up (Fire Blast's spinning wheel, Thunderbolt's charge) starts as the animation
#     starts -- skipping into it if the animation reaches its impact sooner -- and cuts to the hit the
#     moment the impact lands; a move split into "part 1" / "part 2" plays part 1, then part 2 on impact
#   - a clip that IS the hit (Tackle, Mega Punch) plays on the impact / bump
#   - a multi-hit reaction plays the move's single-hit take once per hit
#   - a non-damaging or power-up attack just plays its clip from the start
# Damage adds the battle "hit" thump (super effective / not very effective for Weakness / Resistance).

## True when move sounds are playing -- main skips its old generic damage / status sounds then.
func sfx_on() -> bool:
	return _enabled() and not _sfx.is_empty()


## Debugger: every clip, its analysis, and a plain play of it.
func sound_clips() -> Array:
	var k := _sfx.keys()
	k.sort_custom(func(x, y): return str(x).naturalnocasecmp_to(str(y)) < 0)
	return k

func sound_info(clip: String) -> Dictionary:
	return _sfx.get(clip, {})

func audition(clip: String) -> void:
	_sfx_play(clip, 0.0, -1.0, MOVE_DB, 1.0)


## True if a hit thump played in the last moment (main's generic damage sound would double it).
func hit_sound_recent() -> bool:
	return Time.get_ticks_msec() / 1000.0 - _last_hit_sound < 1.5


func _sfx_begin(ctx: _Ctx, steps: Array, body: String, contact: bool, est: float) -> void:
	var clip := str(ctx.recipe.get("_sfx", ctx.recipe.get("sfx", "")))
	if clip == "" or not _sfx.has(clip):
		return
	var info: Dictionary = _sfx[clip]
	var pitch := float(ctx.recipe.get("sfx_pitch", 1.0))
	var db: float = STATUS_DB if ctx.attacker == ctx.defender else MOVE_DB
	var est_real := GameState.match_time(est)
	if ctx.attacker == ctx.defender or ctx.react.is_empty() or not _has_target(steps):
		_sfx_play(clip, 0.0, minf(float(info.get("dur", 1.0)), est_real + SFX_TAIL), db, pitch)
		return
	var hits := int(ctx.recipe.get("hits", 1))
	var one := _one_hit(clip)
	if hits > 1 and one != "":
		ctx.sfx_plan = {"multi": one, "hits": hits, "pitch": pitch, "db": db}
		return
	var est_imp := GameState.match_time(_impact_estimate(steps, body, contact))
	var base := clip.trim_suffix(" part 1").trim_suffix(" part 2")
	if _sfx.has(base + " part 1") and _sfx.has(base + " part 2"):
		var d1 := float(_sfx[base + " part 1"].get("dur", 0.0))
		ctx.sfx_start = _sfx_play(base + " part 1", maxf(0.0, d1 - est_imp), -1.0, db, pitch)
		ctx.sfx_plan = {"clip": base + " part 2", "from": 0.0, "pitch": pitch, "db": db}
		return
	var hit := float(info.get("hit", 0.0))
	if hit > 0.2:
		ctx.sfx_start = _sfx_play(clip, maxf(0.0, hit - est_imp), -1.0, db, pitch)
		ctx.sfx_plan = {"clip": clip, "from": maxf(0.0, hit - 0.02), "pitch": pitch, "db": db}
	else:
		ctx.sfx_plan = {"clip": clip, "from": 0.0, "pitch": pitch, "db": db}


func _sfx_impact(ctx: _Ctx) -> void:
	if ctx.sfx_start != null and is_instance_valid(ctx.sfx_start):
		_sfx_stop(ctx.sfx_start, SFX_CUT_FADE)
	ctx.sfx_start = null
	var plan := ctx.sfx_plan
	ctx.sfx_plan = {}
	if plan.has("multi"):
		_sfx_repeat(str(plan["multi"]), int(plan["hits"]), float(plan["pitch"]), float(plan["db"]))
	elif plan.has("clip"):
		_sfx_play(str(plan["clip"]), float(plan["from"]), SFX_MAX_LEN, float(plan["db"]), float(plan["pitch"]))
	# The battle "hit" thump on damage.
	var damage := int(ctx.react.get("damage", 0))
	var resisted := bool(ctx.react.get("resisted", false))
	if ctx.react.is_empty() or (damage <= 0 and not resisted) or ctx.defender == ctx.attacker:
		return
	var role := "hit"
	if bool(ctx.react.get("weak", false)):
		role = "hit_weak"
	elif resisted:
		role = "hit_resist"
	var bench := bool(ctx.recipe.get("_bench", false))
	if bench:
		role = "bench"
	_last_hit_sound = Time.get_ticks_msec() / 1000.0
	_sfx_later(str(_sounds.get(role, "")), HIT_DELAY, BENCH_DB if bench else HIT_DB, 1.08 if bench else 1.0)


func _sfx_later(clip: String, delay: float, db: float, pitch: float) -> void:
	if clip == "":
		return
	if delay > 0.0:
		await get_tree().create_timer(delay).timeout
	_sfx_play(clip, 0.0, -1.0, db, pitch)


## One hit per reaction hit, MULTI_GAP apart (match-time scaled, like the reaction itself).
func _sfx_repeat(clip: String, hits: int, pitch: float, db: float) -> void:
	for i in hits:
		_sfx_play(clip, 0.0, -1.0, db, pitch * (1.0 + 0.04 * float(i % 2)))
		if i < hits - 1:
			await get_tree().create_timer(maxf(GameState.match_time(MULTI_GAP), 0.03)).timeout


## Plays `clip` from `from` seconds, for at most `length` seconds (fading out) when length > 0.
func _sfx_play(clip: String, from: float, length: float, db: float, pitch: float) -> AudioStreamPlayer:
	if clip == "" or _voices >= MAX_VOICES:
		return null
	var stream := _sfx_stream(clip)
	if stream == null:
		return null
	var p := AudioStreamPlayer.new()
	p.stream = stream
	p.bus = SFX_BUS
	p.volume_db = db
	p.pitch_scale = maxf(0.1, pitch * randf_range(1.0 - PITCH_JITTER, 1.0 + PITCH_JITTER))
	add_child(p)
	_voices += 1
	p.finished.connect(func() -> void: _sfx_release(p))
	p.play(clampf(from, 0.0, maxf(0.0, float(_sfx.get(clip, {}).get("dur", 0.0)) - 0.02)))
	if length <= 0.0:
		# Uncapped: still released on a timer in case `finished` never comes (a muted / dummy audio driver).
		length = float(_sfx.get(clip, {}).get("dur", 1.0)) / p.pitch_scale + SFX_FADE + 0.1
	_sfx_stop_after(p, length)
	return p


func _sfx_stop_after(p: AudioStreamPlayer, length: float) -> void:
	await get_tree().create_timer(maxf(length - SFX_FADE, 0.01)).timeout
	if is_instance_valid(p):   # it may have finished and been freed already
		_sfx_stop(p, SFX_FADE)


func _sfx_stop(p: Variant, fade: float) -> void:
	if not is_instance_valid(p) or p.has_meta("released"):
		return
	var tw: Tween = p.create_tween()
	tw.tween_property(p, "volume_db", -60.0, maxf(fade, 0.01))
	await tw.finished
	_sfx_release(p)


func _sfx_release(p: Variant) -> void:
	if not is_instance_valid(p) or p.has_meta("released"):
		return
	p.set_meta("released", true)
	_voices = maxi(0, _voices - 1)
	p.stop()
	p.queue_free()


func _sfx_stream(clip: String) -> AudioStream:
	if not _streams.has(clip):
		var s = load(SFX_DIR + clip + ".ogg")
		_streams[clip] = s if s is AudioStream else null
		if _streams[clip] == null:
			push_warning("ATTACK VFX: no sound " + clip)
	return _streams[clip]


## "Fury Attack" / "Fury Attack 1hit" / "Fury Attack 2hits" -> "Fury Attack 1hit", if the pack has one.
func _one_hit(clip: String) -> String:
	var base := clip.trim_suffix(" 1hit").trim_suffix(" 2hits")
	return base + " 1hit" if _sfx.has(base + " 1hit") else ""


func _has_target(steps: Array) -> bool:
	for s in steps:
		if str(s.get("at", "")) != "self":
			return true
	return false


## Base seconds from the start of a play to its impact: the steps before the first target-side one
## (and, for a contact body, the dart in).
func _impact_estimate(steps: Array, body: String, contact: bool) -> float:
	if contact:
		var pre: Array = []
		for s in steps:
			if str(s.get("at", "")) != "self":
				break
			pre.append(s)
		var times: Array = LUNGE_TIMES
		match body:
			"dash": times = DASH_TIMES
			"spin": times = SPIN_TIMES
			"leap": times = LEAP_TIMES
			"dive": times = DIVE_TIMES
			"vanish_strike": times = VANISH_TIMES
		var dart := 0.0
		for i in times.size() - 1:
			dart += float(times[i])
		return _estimate(pre) + dart
	var t := 0.0
	for g in _groups(steps):
		for s in g:
			var at := str(s.get("at", ""))
			if at in ["target", "drop", "screen", "bench", "quake", "beam"]:
				var extra := float(s.get("delay", 0.0))
				if at == "beam":
					extra += float(s.get("dur", BEAM_TIME)) * 0.22
				elif at == "drop":
					extra += maxf(0.0, float(s.get("time", TRAVEL_TIME)))
				return t + extra
		t += _estimate(g)
	return t


# ============================================================
# SCREEN
# ============================================================

func _screen_rect() -> Rect2:
	var vs := get_viewport().get_visible_rect().size
	var tl: Vector2 = main.get_global_transform().affine_inverse() * Vector2.ZERO
	return Rect2(tl - Vector2(60, 60), vs + Vector2(120, 120))


func _overlay(colour: Color, z: int) -> ColorRect:
	var r := ColorRect.new()
	r.color = colour
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var sr := _screen_rect()
	r.position = sr.position
	r.size = sr.size
	r.z_index = z
	r.z_as_relative = false
	main.add_child(r)
	return r


## Darkens the board under the two Actives (their ghosts sit above the dim) for `hold` base seconds.
func _dim_start(ctx: _Ctx, amount: float, hold: float) -> ColorRect:
	var r := _overlay(Color(0, 0, 0, 0), DIM_Z)
	var tw := r.create_tween()
	tw.tween_property(r, "color:a", clampf(amount, 0.0, 0.9), GameState.match_time(DIM_IN))
	# Keep both Actives above the dim the whole time.
	if main.card_fx != null:
		for c in [ctx.attacker, ctx.defender]:
			if c != null:
				main.card_fx.motion(c, GameState.match_time(hold), func(_e: Dictionary, _f: float) -> void: pass)
	return r


func _dim_end(r: ColorRect) -> void:
	if not is_instance_valid(r):
		return
	var tw := r.create_tween()
	tw.tween_property(r, "color:a", 0.0, GameState.match_time(DIM_OUT))
	await tw.finished
	if is_instance_valid(r):
		r.queue_free()


func _screen_flash(ctx: _Ctx, colour: Color) -> void:
	var r := _overlay(Color(colour.r, colour.g, colour.b, SCREEN_FLASH_ALPHA), FLASH_Z)
	ctx.jobs.add()
	var tw := r.create_tween()
	tw.tween_property(r, "color:a", 0.0, GameState.match_time(SCREEN_FLASH_TIME)).set_ease(Tween.EASE_OUT)
	tw.tween_callback(r.queue_free)
	tw.tween_callback(ctx.jobs.finish)


## Shakes the whole board (main) by up to `px`, then puts it back exactly where it was.
func _screen_shake(ctx: _Ctx, px: float) -> void:
	if not main is Control:
		return
	if _shake_users == 0:
		_shake_base = main.position
	_shake_users += 1
	ctx.jobs.add()
	var dur := GameState.match_time(SCREEN_SHAKE_TIME)
	var step := func(f: float) -> void:
		if not is_instance_valid(main):
			return
		var amp := px * (1.0 - f)
		var i := int(f * dur / maxf(SCREEN_SHAKE_STEP, 0.001))
		main.position = _shake_base + Vector2(amp if i % 2 == 0 else -amp, (amp * 0.6) * (1.0 if i % 3 == 0 else -1.0))
	var tw := create_tween()
	tw.tween_method(step, 0.0, 1.0, maxf(dur, 0.01))
	await tw.finished
	_shake_users -= 1
	if _shake_users <= 0 and is_instance_valid(main):
		_shake_users = 0
		main.position = _shake_base
	ctx.jobs.finish()


# ============================================================
# STEPS
# ============================================================

## Steps run in groups: a step starts a new group unless it has "par", which joins the group before it.
## Groups play one after another; a group ends when all its steps have.
func _run_groups(ctx: _Ctx, steps: Array) -> void:
	var groups := _groups(steps)
	for g in groups:
		if _bail():
			return
		var join := _Join.new()
		for s in g:
			# The first target-side step is the impact, unless a step says "impact" itself.
			var at := str(s.get("at", "target"))
			var is_impact: bool = bool(s.get("impact", false)) or at in ["target", "drop", "screen", "bench", "quake"]
			join.add()
			_play_step(ctx, s, join, is_impact)
		await join.wait_all()


func _groups(steps: Array) -> Array:
	var groups: Array = []
	for s in steps:
		if groups.is_empty() or not bool(s.get("par", false)):
			groups.append([s])
		else:
			groups[-1].append(s)
	return groups


## Roughly how long `steps` take, in base seconds -- sizes the on-the-spot body motions.
func _estimate(steps: Array) -> float:
	var total := 0.0
	for g in _groups(steps):
		var longest := 0.0
		for s in g:
			var at := str(s.get("at", "target"))
			var n := int(_manifest.get(str(s.get("fx", "")), {}).get("frames", []).size())
			var one: float
			match at:
				"travel", "return", "drop":
					one = float(s.get("time", TRAVEL_TIME))
					if at == "drop" and one <= 0.0:
						one = _run_time(s, n)
				"beam":
					one = float(s.get("dur", BEAM_TIME))
				"quake":
					one = float(s.get("dur", 0.6))
				_:
					one = _run_time(s, n) * maxf(1.0, float(s.get("loops", 1)))
			one += float(s.get("delay", 0.0)) + float(s.get("stagger", 0.0)) * float(maxi(0, int(s.get("count", 1)) - 1))
			longest = maxf(longest, one)
		total += longest
	return total


func _play_step(ctx: _Ctx, s: Dictionary, join: _Join, is_impact: bool) -> void:
	var delay := float(s.get("delay", 0.0))
	if delay > 0.0:
		await _wait(delay)
	var at := str(s.get("at", "target"))
	var count := maxi(1, int(s.get("count", 1)))
	var stagger := float(s.get("stagger", 0.0))
	if s.has("sfx"):
		_sfx_play(str(s["sfx"]), 0.0, -1.0, STAT_DB, 1.0)
	if not at in ["drop", "beam"] and is_impact:
		_impact(ctx)
	match at:
		"quake":
			_quake(ctx, float(s.get("dur", 0.6)))
			await _wait(float(s.get("dur", 0.6)))
		"bench", "own_bench":
			var bench: Array = _bench_of(ctx.attacker if at == "own_bench" else ctx.defender)
			var j := _Join.new()
			for card in bench:
				var r := _card_rect(card)
				if r.size == Vector2.ZERO:
					continue
				j.add()
				_play_copy(ctx, s, r.get_center(), r.size.x, j)
				if at == "bench" and not ctx.react.is_empty():
					_bench_flinch(ctx, card)
			await j.wait_all()
		"beam":
			await _beam(ctx, s)
		_:
			var j := _Join.new()
			for i in count:
				j.add()
				_play_one(ctx, s, i * stagger, j, is_impact and i == 0)
			await j.wait_all()
	join.finish()


## A benched Pokémon caught by the splash: a small flinch in the element's colour.
func _bench_flinch(ctx: _Ctx, card: card_object) -> void:
	if main.card_fx == null:
		return
	var flash: Color = _elem_colour(ctx, "flash", FLASH_PLAIN)
	var dir := ctx.dir
	main.card_fx.motion(card, GameState.match_time(0.35), func(e: Dictionary, f: float) -> void:
		e["offset"] = dir * 8.0 * sin(f * PI)
		e["tint"] = flash.lerp(Color.WHITE, clampf(f * 2.5, 0.0, 1.0)))


## One copy of a step: placed, travelling or dropping.
func _play_one(ctx: _Ctx, s: Dictionary, delay: float, j: _Join, is_impact: bool) -> void:
	if delay > 0.0:
		await _wait(delay)
	var at := str(s.get("at", "target"))
	var jit := float(s.get("jitter", 0.0))
	match at:
		"travel", "return":
			var from: Vector2 = ctx.a_rect.get_center()
			var to: Vector2 = ctx.d_rect.get_center()
			if at == "return":
				var tmp := from
				from = to
				to = tmp
			if jit > 0.0:
				var w := ctx.d_rect.size.x
				to += Vector2(randf_range(-jit, jit) * w, randf_range(-jit, jit) * w)
			await _fly(ctx, s, from, to, at == "return")
		"drop":
			var land: Vector2 = _anchor_point(ctx, s, ctx.d_rect)
			if jit > 0.0:
				land += Vector2(randf_range(-jit, jit), randf_range(-jit, jit)) * ctx.d_rect.size.x
			if float(s.get("time", TRAVEL_TIME)) <= 0.0:
				if is_impact:
					_impact(ctx)
				await _play_copy(ctx, s, land, ctx.d_rect.size.x, null)
			else:
				await _fly(ctx, s, land + Vector2(0, -DROP_HEIGHT), land, false)
				if is_impact:
					_impact(ctx)
		_:
			var rect: Rect2 = ctx.a_rect if at == "self" else ctx.d_rect
			var p: Vector2 = _anchor_point(ctx, s, rect)
			if at == "screen":
				p = (ctx.a_rect.get_center() + ctx.d_rect.get_center()) / 2.0 + _offset(ctx, s, rect)
			if jit > 0.0:
				p += Vector2(randf_range(-jit, jit), randf_range(-jit, jit)) * rect.size.x
			await _play_copy(ctx, s, p, rect.size.x, null)
	j.finish()


## Plays the step's frames once (or `loops` times) at `pos`.
func _play_copy(ctx: _Ctx, s: Dictionary, pos: Vector2, card_w: float, j: _Join) -> void:
	var spr := _spawn(ctx, s, card_w)
	if spr == null:
		if j != null:
			j.finish()
		return
	spr.global_position = pos
	var frames: Array = spr.get_meta("frames")
	var run := _run_time(s, frames.size())
	var loops := maxi(1, int(s.get("loops", 1)))
	var dur := GameState.match_time(run * loops)
	await _animate(spr, s, frames, dur, loops, Vector2.ZERO, Vector2.ZERO, 0.0)
	if is_instance_valid(spr):
		spr.queue_free()
	if j != null:
		j.finish()


## A projectile: frames loop for the whole flight.
func _fly(ctx: _Ctx, s: Dictionary, from: Vector2, to: Vector2, reverse: bool) -> void:
	var spr := _spawn(ctx, s, ctx.d_rect.size.x, reverse)
	if spr == null:
		return
	spr.global_position = from
	var frames: Array = spr.get_meta("frames")
	var flight := GameState.match_time(float(s.get("time", TRAVEL_TIME)))
	var run := _run_time(s, frames.size())
	var loops := maxf(1.0, float(s.get("time", TRAVEL_TIME)) / maxf(run, 0.01))
	await _animate(spr, s, frames, flight, loops, from, to, float(s.get("arc", 0.0)))
	if is_instance_valid(spr):
		spr.queue_free()


## A beam: the frames stretched from the attacker's edge to the defender, growing out, holding, fading.
## "axis": "v" for frames drawn upright (their bottom is the source end), "h" for frames facing right.
func _beam(ctx: _Ctx, s: Dictionary) -> void:
	var spr := _spawn(ctx, s, ctx.a_rect.size.x)
	if spr == null:
		return
	var info: Dictionary = _manifest.get(str(s.get("fx", "")), {})
	var fw := float(info.get("w", 16))
	var fh := float(info.get("h", 16))
	var vertical := str(s.get("axis", "v")) == "v"
	var from: Vector2 = ctx.a_rect.get_center() + ctx.dir * ctx.a_rect.size.x * 0.3
	var to: Vector2 = ctx.d_rect.get_center()
	var length := from.distance_to(to)
	var thick: float = spr.scale.x   # _spawn sized the frame's thickness off the card
	spr.flip_h = false
	spr.global_position = from
	if vertical:
		spr.offset = Vector2(0, -fh / 2.0)
		spr.rotation = ctx.dir.angle() + PI / 2.0
	else:
		spr.offset = Vector2(fw / 2.0, 0)
		spr.rotation = ctx.dir.angle()
	var long_len := fh if vertical else fw
	var full := length / maxf(long_len, 1.0)
	var dur := GameState.match_time(float(s.get("dur", BEAM_TIME)))
	var frames: Array = spr.get_meta("frames")
	var n := frames.size()
	var cycle := maxf(GameState.match_time(_run_time(s, n)), 0.01)
	var hue_cycle := float(s.get("hue_cycle", 0.0))
	var impact_sent := [false]
	var step := func(f: float) -> void:
		if not is_instance_valid(spr):
			return
		var grow := clampf(f / 0.22, 0.0, 1.0)
		var long_s := full * _ease_out(grow)
		var thin := 1.0 + 0.12 * sin(f * dur * 40.0)
		spr.scale = Vector2(thick * thin, long_s) if vertical else Vector2(long_s, thick * thin)
		spr.texture = frames[int(f * dur / cycle * n) % n]
		spr.modulate.a = clampf((1.0 - f) / 0.2, 0.0, 1.0)
		if hue_cycle != 0.0 and spr.material is ShaderMaterial:
			(spr.material as ShaderMaterial).set_shader_parameter("hue_shift", fposmod(f * dur * hue_cycle / 360.0, 1.0))
		if grow >= 1.0 and not impact_sent[0]:
			impact_sent[0] = true
			_impact(ctx)
	var tw := spr.create_tween()
	tw.tween_method(step, 0.0, 1.0, maxf(dur, 0.01))
	await tw.finished
	if not impact_sent[0]:
		_impact(ctx)
	if is_instance_valid(spr):
		spr.queue_free()


## Drives one sprite over `dur`: frame, position (when from != to), spin, grow, fade, hue cycle.
func _animate(spr: Sprite2D, s: Dictionary, frames: Array, dur: float, loops: float, from: Vector2, to: Vector2, arc: float) -> void:
	var n := frames.size()
	var base_scale: Vector2 = spr.scale
	var base_rot: float = spr.rotation
	var spin := deg_to_rad(float(s.get("spin", 0.0)))
	var grow: Array = s.get("grow", [])
	var fade := GameState.match_time(float(s.get("fade", 0.0)))
	var hue_cycle := float(s.get("hue_cycle", 0.0))
	var moving := from != to
	var spin_dir := -1.0 if spr.flip_h else 1.0
	if dur <= 0.0:
		return
	var step := func(f: float) -> void:
		if not is_instance_valid(spr):
			return
		var idx: int = n - 1 if f >= 1.0 else int(f * loops * n) % n
		spr.texture = frames[idx]
		if moving:
			spr.global_position = from.lerp(to, f) + Vector2(0, -arc * sin(f * PI))
		if spin != 0.0:
			spr.rotation = base_rot + spin * spin_dir * f * dur
		if grow.size() == 2:
			spr.scale = base_scale * lerpf(float(grow[0]), float(grow[1]), f)
		if fade > 0.0:
			spr.modulate.a = clampf((1.0 - f) * dur / fade, 0.0, 1.0)
		if hue_cycle != 0.0 and spr.material is ShaderMaterial:
			(spr.material as ShaderMaterial).set_shader_parameter("hue_shift", fposmod(f * dur * hue_cycle / 360.0, 1.0))
	var tw := spr.create_tween()
	tw.tween_method(step, 0.0, 1.0, dur)
	await tw.finished


func _spawn(ctx: _Ctx, s: Dictionary, card_w: float, reverse: bool = false) -> Sprite2D:
	var part := str(s.get("fx", ""))
	var frames := _frames(part, s.get("range", []))
	if frames.is_empty():
		return null
	var info: Dictionary = _manifest.get(part, {})
	var fw := float(info.get("w", frames[0].get_width()))
	var fh := float(info.get("h", frames[0].get_height()))
	var spr := Sprite2D.new()
	spr.texture = frames[0]
	spr.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	spr.set_meta("frames", frames)
	# Size: the longest side of a frame as a fraction of the card's width (a beam: its short side).
	var at := str(s.get("at", "target"))
	var size_f := float(s.get("size", SIZE_DEFAULT.get(at, 1.0)))
	var measure := maxf(fw, fh) if at != "beam" else (fw if str(s.get("axis", "v")) == "v" else fh)
	var sc := size_f * SIZE_MULT * maxf(card_w, 1.0) / maxf(measure, 1.0)
	if s.has("scale"):
		sc = float(s["scale"])
	if not s.has("scale") and not at in ["beam", "screen"]:
		sc = minf(sc, MAX_SCALE)
	sc = maxf(SCALE_STEP, roundf(sc / SCALE_STEP) * SCALE_STEP) if sc >= 1.0 else sc
	spr.scale = Vector2(sc, sc)
	if str(s.get("anchor", "")) == "bottom":
		spr.offset = Vector2(0, -fh / 2.0)
	# Facing: frames face RIGHT. On the opponent's turn the attack runs right-to-left.
	var dir := -ctx.dir if reverse else ctx.dir
	var facing_left := dir.x < -0.01
	if bool(s.get("orient", false)):
		spr.flip_h = facing_left
		var a := dir.angle()
		spr.rotation = wrapf(a - PI, -PI, PI) if facing_left else a
	elif bool(s.get("mirror", true)):
		spr.flip_h = facing_left
	if s.has("tint"):
		spr.modulate = Color(str(s["tint"]))
	if s.has("hue") or s.has("hue_cycle"):
		var mat := ShaderMaterial.new()
		mat.shader = _hue_shader
		mat.set_shader_parameter("hue_shift", float(s.get("hue", 0.0)) / 360.0)
		spr.material = mat
	if bool(s.get("add", false)):
		var cm := CanvasItemMaterial.new()
		cm.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
		if spr.material == null:
			spr.material = cm
	_layer.add_child(spr)
	ctx.sprites.append(spr)
	return spr


func _frames(part: String, rng: Array) -> Array:
	if not _frames_cache.has(part):
		var list: Array = []
		var info: Dictionary = _manifest.get(part, {})
		for f in info.get("frames", []):
			var tex = load(FX_DIR + part + "/" + str(f))
			if tex is Texture2D:
				list.append(tex)
		if list.is_empty():
			push_warning("ATTACK VFX: no frames for " + part)
		_frames_cache[part] = list
	var all: Array = _frames_cache[part]
	if rng.size() == 2 and not all.is_empty():
		var a := clampi(int(rng[0]), 0, all.size() - 1)
		var b := clampi(int(rng[1]), a, all.size() - 1)
		return all.slice(a, b + 1)
	return all


func _run_time(s: Dictionary, n: int) -> float:
	if s.has("dur"):
		return float(s["dur"])
	return clampf(float(n) / FRAME_FPS, RUN_MIN, RUN_MAX)


## Where on `rect` a step sits: the centre, or for anchor "bottom" the point its bottom edge rests on.
func _anchor_point(ctx: _Ctx, s: Dictionary, rect: Rect2) -> Vector2:
	return rect.get_center() + _offset(ctx, s, rect)


## "off" is in card widths / heights; +x points at the opponent, so it mirrors on their turn.
func _offset(ctx: _Ctx, s: Dictionary, rect: Rect2) -> Vector2:
	var off: Array = s.get("off", [])
	if off.size() != 2:
		return Vector2.ZERO
	var x := float(off[0]) * rect.size.x * (-1.0 if ctx.dir.x < -0.01 else 1.0)
	return Vector2(x, float(off[1]) * rect.size.y)


func _quake(ctx: _Ctx, dur: float) -> void:
	var fx = main.card_fx
	if fx == null:
		return
	var count := maxi(2, int(dur / QUAKE_STEP))
	var cards: Array = [main.player_active_pokemon, main.opponent_active_pokemon]
	cards.append_array(main.player_bench)
	cards.append_array(main.opponent_bench)
	for c in cards:
		# The defender is already being knocked about by the hit -- leave it to that.
		if c != null and c != ctx.attacker and not (c == ctx.defender and not ctx.react.is_empty()):
			fx.jolt(c, QUAKE_PX, QUAKE_STEP, count)


func _bench_of(card: card_object) -> Array:
	if card == null:
		return []
	return main.opponent_bench if card.is_owner_opp(main) else main.player_bench


func _both_active(a: card_object, d: card_object) -> bool:
	var actives := [main.player_active_pokemon, main.opponent_active_pokemon]
	return a in actives and d in actives


func _all_self(steps: Array) -> bool:
	for s in steps:
		if str(s.get("at", "")) != "self":
			return false
	return true


## An element colour: "#rrggbb", or [r, g, b] where values over 1 brighten (the hit flashes).
func _elem_colour(ctx: _Ctx, key: String, fallback: Color) -> Color:
	if not ctx.elem.has(key):
		return fallback
	var v = ctx.elem[key]
	if v is Array and (v as Array).size() >= 3:
		return Color(float(v[0]), float(v[1]), float(v[2]), 1.0)
	return Color(str(v))


func _card_rect(card: card_object) -> Rect2:
	if card == null:
		return Rect2()
	var node: Control = main.find_card_ui_for_object(card)
	if node == null or not is_instance_valid(node) or not node.is_visible_in_tree():
		return Rect2()
	var sz: Vector2 = node.size * node.get_global_transform().get_scale()
	if sz.x <= 1.0:
		sz = Vector2(FALLBACK_CARD_W, FALLBACK_CARD_W * 1.385)
	return Rect2(node.global_position, sz)


func _wait(seconds: float) -> void:
	var t: float = GameState.match_time(seconds)
	if t > 0.0:
		await get_tree().create_timer(t).timeout


func _bail() -> bool:
	return main == null or not is_instance_valid(main) or main._should_bail()


func _cleanup(ctx: _Ctx) -> void:
	for spr in ctx.sprites:
		if is_instance_valid(spr):
			spr.queue_free()
	ctx.sprites.clear()


static func _ease_out(x: float) -> float:
	return 1.0 - (1.0 - x) * (1.0 - x)


static func _ease_out_back(x: float) -> float:
	var c1 := 1.70158
	var c3 := c1 + 1.0
	return 1.0 + c3 * pow(x - 1.0, 3.0) + c1 * pow(x - 1.0, 2.0)


## Recolours an effect: rotates each pixel's hue by hue_shift (0..1 = a full turn), keeps alpha.
const HUE_SHADER := """
shader_type canvas_item;
uniform float hue_shift = 0.0;
vec3 rgb2hsv(vec3 c) {
	vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
	float d = q.x - min(q.w, q.y);
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1.0e-10)), d / (q.x + 1.0e-10), q.x);
}
vec3 hsv2rgb(vec3 c) {
	vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
	return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}
void fragment() {
	// COLOR arrives as the texture times the sprite's modulate.
	vec4 col = COLOR;
	vec3 hsv = rgb2hsv(col.rgb);
	hsv.x = fract(hsv.x + hue_shift);
	COLOR = vec4(hsv2rgb(hsv), col.a);
}
"""
