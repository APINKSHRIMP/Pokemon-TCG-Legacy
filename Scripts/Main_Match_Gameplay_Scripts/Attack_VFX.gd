var _manifest: Dictionary = {}
var _recipes: Dictionary = {}
var _status: Dictionary = {}
var _fallback: Dictionary = {}
var _utility: Dictionary = {}
var _elements: Dictionary = {}
var _map: Dictionary = {}
var _frames_cache: Dictionary = {}    # part -> Array[Texture2D]
var _layer: Node2D = null
var _hue_shader: Shader = null
## {"attacker", "attack", "turn", "played"} -- see the header.
var _pending: Dictionary = {}
## The attack playing right now -- bench hits copy its effect. {"recipe", "attacker", "turn"}
var _last_play: Dictionary = {}
var _bench_next := 0.0
var _sfx: Dictionary = {}         # clip -> {dur, hit, onsets}
var _sounds: Dictionary = {}      # role -> clip ("hit", "hit_weak", "bench", "stat_up"...)
var _streams: Dictionary = {}     # clip -> AudioStream
