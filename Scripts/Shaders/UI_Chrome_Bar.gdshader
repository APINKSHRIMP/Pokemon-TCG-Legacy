shader_type canvas_item;

// ============================================================
// UI CHROME BAR — the header and footer gradient plus its chevrons
// ============================================================
// One node draws the whole bar: a three-stop horizontal gradient with the
// scrolling diagonal stripe pattern composited on top. Replaces the old
// black/blue dotted border textures.
//
// ── WHY THE STRIPES ARE COMPUTED IN PIXELS, NOT UV ───────────
// rect_size is passed in and every stripe measurement is taken in real pixels,
// so a 92px-tall header and a 162px-tall match footer show stripes of the SAME
// width at the SAME angle. Doing it in UV would stretch the pattern to the
// rect and the two bars would visibly disagree.
//
// ── WHY THERE IS NO WRAP SEAM ────────────────────────────────
// The spec warns that the loop distance must be an exact multiple of the
// pattern period or the texture jumps on wrap. That bug belongs to an animated
// background-position; here the pattern is generated by mod() against the
// period, so it is periodic by construction and ANY offset is seamless. The
// spec's 34px-over-6.8s is still honoured, it just arrives as a plain 5 px/s.
//
// ── REDUCED MOTION ───────────────────────────────────────────
// Set scroll_speed to 0.0. The stripes stay, they simply stop. Do not hide
// them — they are a third of what carries the theme.
// ============================================================

// Gradient, left to right. Stop B sits at grad_b_pos (0.52 in Spectrum Night)
// so the pink lands slightly right of centre and the orange gets more room.
uniform vec4  grad_a      : source_color = vec4(0.482, 0.247, 0.831, 1.0);  // 7B3FD4
uniform vec4  grad_b      : source_color = vec4(0.910, 0.271, 0.608, 1.0);  // E8459B
uniform vec4  grad_c      : source_color = vec4(0.961, 0.475, 0.231, 1.0);  // F5793B
uniform float grad_b_pos  = 0.52;

// Chevrons
uniform vec4  stripe_color : source_color = vec4(1.0, 1.0, 1.0, 0.06);
uniform float angle_deg    = 115.0;
uniform float stripe_width = 3.0;    // px of ink
uniform float period       = 17.0;   // px from one stripe's start to the next
uniform float scroll_speed = 5.0;    // px/s along +X; negative scrolls left

uniform vec2  rect_size    = vec2(1920.0, 92.0);

// Optional rounded corners, off by default — the bars run edge to edge.
uniform float corner_radius = 0.0;

void fragment() {
	vec2 p = UV * rect_size;

	// ── Gradient ──
	// Two mixes rather than one so the middle stop can sit off-centre.
	float t = UV.x;
	vec3 grad = t < grad_b_pos
		? mix(grad_a.rgb, grad_b.rgb, t / max(grad_b_pos, 0.0001))
		: mix(grad_b.rgb, grad_c.rgb, (t - grad_b_pos) / max(1.0 - grad_b_pos, 0.0001));

	// ── Chevrons ──
	// n is the unit normal to the stripe direction, so dot(p, n) is the
	// perpendicular distance across the stripes. Subtracting the scroll from p
	// along +X translates the whole pattern rightward at scroll_speed px/s.
	float a = radians(angle_deg);
	vec2  n = vec2(-sin(a), cos(a));
	vec2  moved = p - vec2(TIME * scroll_speed, 0.0);
	float d = mod(dot(moved, n), period);

	// A one-pixel smoothstep on each side keeps a 3px diagonal from crawling.
	// Two bands so the stripe nearest d == period also antialiases correctly.
	float edge = 1.0;
	float ink = smoothstep(-edge, edge, d) - smoothstep(stripe_width - edge, stripe_width + edge, d);

	vec3 col = mix(grad, stripe_color.rgb, ink * stripe_color.a);

	// ── Silhouette ──
	float alpha = 1.0;
	if (corner_radius > 0.0) {
		vec2  hs = rect_size * 0.5;
		float r  = min(corner_radius, min(hs.x, hs.y));
		vec2  q  = abs(p - hs) - (hs - r);
		float sd = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;
		alpha = 1.0 - smoothstep(-0.75, 0.75, sd);
	}

	COLOR = vec4(col, alpha);
}
