{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(godot *)",
      "PowerShell",
      "Bash(dir *)",
      "Bash(sed 's/.*instance=//')"
    ],
    "deny": [
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm *)"
    ],
    "defaultMode": "plan"
  }
}
