{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(godot *)",
      "PowerShell"
    ],
    "deny": [
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm *)"
    ]
  }
}
