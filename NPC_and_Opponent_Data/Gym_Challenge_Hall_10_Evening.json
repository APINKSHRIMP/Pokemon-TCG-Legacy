{
  "npcs": [
    {
      "name": "Gym Challenge Brock Defeated",
      "meet_text": "Hah, that was a rock hard battle! You've got real grit, kid. The next leader is waiting for you - go and show Misty what you're made of!",
      "repeat_text": "Keep that defence as solid as a rock for the leaders ahead of you.",
      "pattern": "idle_down",
      "position": {
        "x": 240,
        "y": 316
      },
      "condition": {
        "type": "opponent_defeated",
        "target": "Gym Challenge Brock"
      }
    },
    {
      "name": "Gym Challenge Misty Locked",
      "meet_text": "You can't challenge me without defeating Brock first! Beat him, then come back and we can play.",
      "repeat_text": "Go and beat Brock over there, then it'll be my turn to make a splash with you!",
      "pattern": "idle_down",
      "position": {
        "x": 320,
        "y": 316
      },
      "condition": {
        "type": "opponent_not_defeated",
        "target": "Gym Challenge Brock"
      }
    },
    {
      "name": "Gym Challenge Misty Defeated",
      "meet_text": "That was a really enjoyable match, we should play again sometime! Good luck with the rest of the challenge - Lt. Surge is up next, don't let him shock you!",
      "repeat_text": "Stay afloat out there! The leaders only get tougher from here.",
      "pattern": "idle_down",
      "position": {
        "x": 320,
        "y": 316
      },
      "condition": {
        "type": "opponent_defeated",
        "target": "Gym Challenge Misty"
      }
    },
    {
      "name": "Gym Challenge Lt. Surge Locked",
      "meet_text": "Whoa there, recruit! Defeat Misty before you come buzzing around me. No shortcuts in my unit!",
      "repeat_text": "No Misty, no match. Go on, move it move it!",
      "pattern": "idle_down",
      "position": {
        "x": 400,
        "y": 316
      },
      "condition": {
        "type": "opponent_not_defeated",
        "target": "Gym Challenge Misty"
      }
    },
    {
      "name": "Gym Challenge Lt. Surge Defeated",
      "meet_text": "Not bad, soldier! You've got the voltage after all. Erika's next - watch she doesn't put you to sleep! Good luck out there.",
      "repeat_text": "Onward and upward, recruit! Don't short out now.",
      "pattern": "idle_down",
      "position": {
        "x": 400,
        "y": 316
      },
      "condition": {
        "type": "opponent_defeated",
        "target": "Gym Challenge Lt. Surge"
      }
    },
    {
      "name": "Gym Challenge Erika Locked",
      "meet_text": "Oh... I'm afraid you must defeat Lt. Surge before challenging me. Patience, like a flower, takes time to bloom.",
      "repeat_text": "Please best Lt. Surge first, then return to me when you are ready.",
      "pattern": "idle_down",
      "position": {
        "x": 480,
        "y": 316
      },
      "condition": {
        "type": "opponent_not_defeated",
        "target": "Gym Challenge Lt. Surge"
      }
    },
    {
      "name": "Gym Challenge Erika Defeated",
      "meet_text": "What a wonderful battle. We should share tea sometime. Koga awaits you next - do be careful of his poisons. May the rest of your challenge bloom beautifully.",
      "repeat_text": "Take a moment to breathe before facing Koga. Good luck.",
      "pattern": "idle_down",
      "position": {
        "x": 480,
        "y": 316
      },
      "condition": {
        "type": "opponent_defeated",
        "target": "Gym Challenge Erika"
      }
    },
    {
      "name": "Gym Challenge Koga Locked",
      "meet_text": "A true ninja knows their order, challenger. Defeat Erika first, then seek me out from the shadows.",
      "repeat_text": "Erika stands between us. Best her, then return to face my poisons.",
      "pattern": "idle_down",
      "position": {
        "x": 240,
        "y": 205
      },
      "condition": {
        "type": "opponent_not_defeated",
        "target": "Gym Challenge Erika"
      }
    },
    {
      "name": "Gym Challenge Koga Defeated",
      "meet_text": "Fwahaha... you have bested my arts. Sabrina senses your approach already... her mind games are not to be taken lightly. Good fortune, challenger.",
      "repeat_text": "Tread carefully from here - Sabrina sees all that is to come.",
      "pattern": "idle_down",
      "position": {
        "x": 240,
        "y": 205
      },
      "condition": {
        "type": "opponent_defeated",
        "target": "Gym Challenge Koga"
      }
    },
    {
      "name": "Gym Challenge Sabrina Locked",
      "meet_text": "I see you have not yet defeated Koga. Return when his poison no longer clouds your path.",
      "repeat_text": "Koga first. The future cannot be rushed, challenger.",
      "pattern": "idle_down",
      "position": {
        "x": 320,
        "y": 205
      },
      "condition": {
        "type": "opponent_not_defeated",
        "target": "Gym Challenge Koga"
      }
    },
    {
      "name": "Gym Challenge Sabrina Defeated",
      "meet_text": "Our minds have touched, and yours prevailed. Blaine burns bright ahead - do not let his flames consume you. Good luck.",
      "repeat_text": "Blaine's fire awaits you. I have already seen it.",
      "pattern": "idle_down",
      "position": {
        "x": 320,
        "y": 205
      },
      "condition": {
        "type": "opponent_defeated",
        "target": "Gym Challenge Sabrina"
      }
    },
    {
      "name": "Gym Challenge Blaine Locked",
      "meet_text": "Cool your jets! Defeat Sabrina first, then we'll see if you can handle my flames!",
      "repeat_text": "No Sabrina, no fire. Come back when you've put out her mind games!",
      "pattern": "idle_down",
      "position": {
        "x": 400,
        "y": 205
      },
      "condition": {
        "type": "opponent_not_defeated",
        "target": "Gym Challenge Sabrina"
      }
    },
    {
      "name": "Gym Challenge Blaine Defeated",
      "meet_text": "What a blazing match! You've got real fire in you. Only Giovanni remains now - the leader of them all. Give it everything you've got! Good luck!",
      "repeat_text": "Giovanni is the final wall. Burn bright, challenger!",
      "pattern": "idle_down",
      "position": {
        "x": 400,
        "y": 205
      },
      "condition": {
        "type": "opponent_defeated",
        "target": "Gym Challenge Blaine"
      }
    },
    {
      "name": "Gym Challenge Giovanni Locked",
      "meet_text": "You are not yet worthy to face me. Defeat Blaine, then perhaps I shall grace you with a match.",
      "repeat_text": "Best Blaine first. Only then will I rise from this seat to meet you.",
      "pattern": "idle_down",
      "position": {
        "x": 480,
        "y": 205
      },
      "condition": {
        "type": "opponent_not_defeated",
        "target": "Gym Challenge Blaine"
      }
    },
    {
      "name": "Gym Challenge Giovanni Defeated",
      "meet_text": "You have conquered the entire Gym Challenge. I underestimated you... Savour this victory, champion. You have earned my respect, and that is no small thing.",
      "repeat_text": "The challenge is complete. You stand above us all now.",
      "pattern": "idle_down",
      "position": {
        "x": 480,
        "y": 205
      },
      "condition": {
        "type": "opponent_defeated",
        "target": "Gym Challenge Giovanni"
      }
    },
